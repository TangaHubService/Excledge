# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Paypack Configuration
PAYPACK_API_URL=https://api.paypack.rw
PAYPACK_CLIENT_ID=your_paypack_client_id
PAYPACK_CLIENT_SECRET=your_paypack_client_secret

# API Configuration
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# PESAPAL Configuration (sandbox)
PESAPAL_CONSUMER_KEY=wCGzX1fNzvtI5lMR5M4AxvxBmLpFgZzp
PESAPAL_CONSUMER_SECRET=uU7R9g2IHn9dkrKDVIfcPppktIo=
PESAPAL_API_URL=https://cybqa.pesapal.com/pesapalv3/api
# Register an IPN URL at https://cybqa.pesapal.com and replace this value
PESAPAL_IPN_ID=your_pesapal_ipn_id_from_dashboard

