  createdAt    DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("supplier_invoice_files")
}

model OcrResult {
  id           Int      @id @default(autoincrement())
