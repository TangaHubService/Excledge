  createdAt    DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("ocr_results")
}

model InvoiceImportLog {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
