  @@unique([organizationId, noticeNo])
  @@index([organizationId, readAt])
  @@map("rra_notices")
}

/// B2B purchase transactions issued TO this taxpayer, pulled from RRA via
/// /trnsPurchase/selectTrnsPurchaseSales (RRA checklist §70). The operator
/// reviews each one and confirms it (/trnsPurchase/savePurchases with
/// pchsSttsCd, RRA checklist §71), which records the purchase and its stock-in.
model RraPurchase {
  id              Int               @id @default(autoincrement())
  organizationId  Int
  spplrTin        String
  spplrNm         String?
  spplrBhfId      String?
  spplrInvcNo     BigInt
  rcptTyCd        String?
  pmtTyCd         String?
  salesDt         String?
  totItemCnt      Int?
  totTaxblAmt     Decimal?          @db.Decimal(15, 2)
  totTaxAmt       Decimal?          @db.Decimal(15, 2)
  totAmt          Decimal?          @db.Decimal(15, 2)
  remark          String?
  status          RraPurchaseStatus @default(PENDING)
  confirmedAt     DateTime?
