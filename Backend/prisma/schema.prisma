/// Import declaration line items received from RRA via /imports/selectImportItems
/// (RRA checklist §66). The operator classifies + approves/rejects each one
/// (/imports/updateImportItems, RRA checklist §68); an approval books the
/// stock-in. §67: each pull's request date must be later than the previous one.
model RraImportItem {
  id             Int              @id @default(autoincrement())
  organizationId Int
  taskCd         String
  dclNo          String?
  dclDe          String // declaration date, yyyyMMdd
  itemSeq        Int
  hsCd           String?
  itemNm         String?
  orgnNatCd      String?
  exptNatCd      String?
  pkg            Decimal?         @db.Decimal(15, 3)
  pkgUnitCd      String?
  qty            Decimal?         @db.Decimal(15, 3)
  qtyUnitCd      String?
  totWt          Decimal?         @db.Decimal(15, 3)
  netWt          Decimal?         @db.Decimal(15, 3)
  spplrNm        String?
  agntNm         String?
  invcFcurAmt    Decimal?         @db.Decimal(18, 4)
  invcFcurCd     String?
  invcFcurExcrt  Decimal?         @db.Decimal(18, 6)
  itemCd         String?
  itemClsCd      String?
  status         RraImportStatus  @default(PENDING)
