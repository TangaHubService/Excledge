generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  name                     String
  businessType             BusinessType                 @default(PHARMACY)
  TIN                      String? // 9-digit RRA Tax Identification Number
  VRN                      String? // VAT Registration Number (for VAT-registered orgs)
  currency                 String?
  ebmDeviceId              String? // Legacy: org-level fallback (use Branch.ebmDeviceId per branch)
  ebmSerialNo              String? // Legacy: org-level fallback (use Branch.ebmSerialNo per branch)
  avatar                   String?
  address                  String?
  phone                    String?
  email                    String?
  isActive                 Boolean                      @default(true)
  trainingMode             Boolean                      @default(false)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  stripeCustomerId         String?
  id                       Int                          @id @default(autoincrement())
  activityLogs             ActivityLog[]
  batches                  Batch[]
  cashBalances             CashBalance[]
  customers                Customer[]
  debtPayments             DebtPayment[]
  ebmOutbox                EbmOutbox[]
  ebmQueue                 EbmQueue[]
  ebmTransactions          EbmTransaction[]
  expenses                 Expense[]
  inventoryLedgers         InventoryLedger[]
  notifications            Notification[]
  invitations              OrganizationInvitation[]
  products                 Product[]
  purchaseOrders           PurchaseOrder[]
  sales                    Sale[]
  stockMovements           StockMovement[]
  subscriptions            Subscription[]               @relation("OrganizationSubscriptions")
  supplierPayments         SupplierPayment[]
  suppliers                Supplier[]
  userOrganizations        UserOrganization[]
  warehouses               Warehouse[]
  branches                 Branch[] // NEW: Branch management
  taxConfigurations        TaxConfiguration[]
  stockTransfers           StockTransfer[]
  invoiceCounters          OrganizationInvoiceCounter[]
  lastSyncCursor           DateTime?                    @map("last_sync_cursor")
  lastSuccessfulVdsContact DateTime?                    @map("last_successful_vds_contact")
  supplierInvoices         SupplierInvoice[]
  invoiceImportLogs        InvoiceImportLog[]
  settings                 OrganizationSetting?
  supplierAccessTokens     SupplierAccessToken[]
  salePayments             SalePayment[]

  @@map("organizations")
}

/// Per-organization workspace customization: sidebar visibility, feature flags, and
/// preferences. Modeled as JSON so new settings ship without a migration (Phase 1 —
/// "Zero-Downtime Adaptability"); each field defaults to `{}` so older rows never
/// need backfilling and the app-layer DEFAULT_SETTINGS fallback stays the source of truth.
model OrganizationSetting {
  id             Int      @id @default(autoincrement())
  organizationId Int      @unique
  sidebarConfig  Json     @default("{}")
  featureFlags   Json     @default("{}")
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// NEW: Branch Model - Core entity for inventory management
model Branch {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  code           String // internal code e.g., "KIGALI-01"
  // RRA/EBM per-branch device credentials (each branch has its own VSDC device)
  bhfId          String? // RRA-assigned branch code, e.g. "00", "01"
  ebmDeviceId    String? // VSDC device ID issued per branch by RRA
  ebmSerialNo    String? // VSDC device serial number issued per branch by RRA
  vsdcUrl        String? // Per-branch VSDC endpoint URL (B3)
  location       String?
  address        String?
  addressLine2   String? // Second address line (B3)
  phone          String?
  status         BranchStatus @default(ACTIVE)
  isDefault      Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userBranches      UserBranch[]
  invitations       OrganizationInvitation[]
  sales             Sale[]
  stockMovements    StockMovement[]
  expenses          Expense[]
  cashBalances      CashBalance[]
  activityLogs      ActivityLog[]
  batches           Batch[]
  inventoryLedgers  InventoryLedger[]
  transfersFrom     StockTransfer[]              @relation("TransferFrom")
  transfersTo       StockTransfer[]              @relation("TransferTo")
  purchaseOrders    PurchaseOrder[]
  invoiceCounters   OrganizationInvoiceCounter[]
  receiptCounters   BranchReceiptCounter[]
  supplierInvoices  SupplierInvoice[]
  invoiceImportLogs InvoiceImportLog[]

  @@unique([organizationId, bhfId])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@map("branches")
}

// NEW: Junction table linking users to branches (many-to-many)
model UserBranch {
  id        Int      @id @default(autoincrement())
  userId    Int
  branchId  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

model Supplier {
  name             String
  email            String
  phone            String?
  address          String?
  contactPerson    String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  id               Int               @id @default(autoincrement())
  organizationId   Int
  products            Product[]
  purchaseOrders      PurchaseOrder[]
  supplierInvoices    SupplierInvoice[]
  supplierAccessTokens SupplierAccessToken[]
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("suppliers")
}

model PurchaseOrder {
  orderNumber      String              @unique
  status           PurchaseOrderStatus @default(PENDING)
  totalAmount      Decimal             @db.Decimal(10, 2)
  notes            String?
  orderedAt        DateTime            @default(now())
  expectedDate     DateTime?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  id               Int                 @id @default(autoincrement())
  supplierId       Int
  organizationId   Int
  branchId         Int // NEW Branch-scoped PO
  userId           Int
  isActive         Boolean             @default(true)
  items            PurchaseOrderItem[]
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  supplierPayments SupplierPayment[]
  User             User[]              @relation("CreatedOrders")
  matchedInvoices  SupplierInvoice[]   @relation("MatchedPurchaseOrder")

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([userId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  productName         String
  quantity            Int
  quantityReceived    Int           @default(0)
  unitPrice           Decimal       @db.Decimal(10, 2)
  totalPrice          Decimal       @db.Decimal(10, 2)
  taxCode             RraTaxCode?   @default(A)
  taxRate             Decimal?      @db.Decimal(5, 2)
  id                  Int           @id @default(autoincrement())
  purchaseOrderId     Int
  productId           Int?
  product             Product?      @relation(fields: [productId], references: [id])
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model User {
  email                    String                   @unique
  password                 String
  name                     String
  phone                    String?
  profileImage             String?
  role                     UserRole                 @default(ADMIN)
  isActive                 Boolean                  @default(false)
  isEmailVerified          Boolean                  @default(false)
  verificationToken        String?
  verificationExpiry       DateTime?
  passwordResetToken       String?
  passwordResetExpiry      DateTime?
  refreshToken             String?
  refreshTokenExpiry       DateTime?
  requirePasswordChange    Boolean                  @default(false)
  defaultPassword          String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  disabledAt               DateTime?
  reactivatedAt            DateTime?
  id                       Int                      @id @default(autoincrement())
  activityLogs             ActivityLog[]
  recordedCashBalances     CashBalance[]            @relation("RecordedCashBalances")
  recordedCostHistory      CostPriceHistory[]       @relation("RecordedCostHistory")
  recordedDebtPayments     DebtPayment[]            @relation("RecordedDebtPayments")
  recordedExpenses         Expense[]
  inventoryLedgers         InventoryLedger[]
  sentInvitations          OrganizationInvitation[] @relation("InvitedBy")
  receivedInvitations      OrganizationInvitation[] @relation("InvitedUser")
  PurchaseOrder            PurchaseOrder[]
  sales                    Sale[]
  stockMovements           StockMovement[]
  recordedSupplierPayments SupplierPayment[]        @relation("RecordedSupplierPayments")
  userOrganizations        UserOrganization[]
  createdOrders            PurchaseOrder[]          @relation("CreatedOrders")
  userBranches             UserBranch[] // NEW: Branch assignments
  createdInvoices          SupplierInvoice[]
  invoiceImportLogs        InvoiceImportLog[]
  createdSubscriptions     Subscription[]           @relation("SubscriptionCreatedBy")

  @@index([deletedAt])
  @@index([passwordResetToken])
  @@index([refreshToken])
  @@map("users")
}

model UserOrganization {
  role           UserRole
  isOwner        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

model OrganizationInvitation {
  email           String
  role            UserRole
  token           String           @unique
  defaultPassword String
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  id              Int              @id @default(autoincrement())
  organizationId  Int
  branchId        Int? // Optional branch-scoped invitation
  invitedBy       Int
  invitedUserId   Int?
  inviter         User             @relation("InvitedBy", fields: [invitedBy], references: [id])
  invitedUser     User?            @relation("InvitedUser", fields: [invitedUserId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invitedBy])
  @@index([email])
  @@index([branchId])
  @@map("organization_invitations")
}

model SubscriptionPlan {
  name          String         @unique
  description   String?
  price         Float
  currency      String         @default("USD")
  billingCycle  String         @default("MONTHLY")
  isActive      Boolean        @default(true)
  maxUsers      Int            @default(1)
  stripePriceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  id            Int            @id @default(autoincrement())
  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Feature {
  name        String        @unique
  description String?
  key         String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  id          Int           @id @default(autoincrement())
  plans       PlanFeature[]

  @@map("features")
}

model PlanFeature {
  isEnabled  Boolean          @default(true)
  limitValue Int?
  planId     Int
  featureId  Int
  feature    Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  status                    SubscriptionStatus @default(PENDING)
  startDate                 DateTime?
  endDate                   DateTime?
  autoRenew                 Boolean            @default(true)
  paymentMethod             PaymentMethodType  @default(STRIPE)
  paymentId                 String?            @unique
  paymentDetails            Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  cancelledAt               DateTime?
  id                        Int                @id @default(autoincrement())
  organizationId            Int
  planId                    Int
  monthsPurchased           Int?
  billingMode               String             @default("MONTHLY")
  monthlyPrice              Float?
  totalAmount               Float?
  gracePeriodDays           Int                @default(3)
  gracePeriodEndsAt         DateTime?
  createdById               Int?
  renewedFromSubscriptionId Int?
  payments                  Payment[]
  organization              Organization       @relation("OrganizationSubscriptions", fields: [organizationId], references: [id])
  plan                      SubscriptionPlan   @relation(fields: [planId], references: [id])
  createdBy                 User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  renewedFrom               Subscription?      @relation("SubscriptionRenewal", fields: [renewedFromSubscriptionId], references: [id])
  renewals                  Subscription[]     @relation("SubscriptionRenewal")

  @@index([organizationId])
  @@index([status])
  @@index([endDate])
  @@index([gracePeriodEndsAt])
  @@map("subscriptions")
}

model Payment {
  amount         Float
  currency       String            @default("USD")
  paymentMethod  PaymentMethodType
  paymentId      String?
  status         PaymentStatus     @default(PENDING)
  receiptUrl     String?
  metadata       Json?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  id             Int               @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentId])
  @@index([status])
  @@map("payments")
}

model Product {
  name                 String
  sku                  String?
  batchNumber          String?
  quantity             Int                   @default(0)
  unitPrice            Decimal               @db.Decimal(10, 2)
  expiryDate           DateTime?
  category             String?
  description          String?
  minStock             Int                   @default(10)
  taxCategory          TaxCategory           @default(STANDARD)
  taxCode              RraTaxCode?
  measurementUnit      MeasurementUnit       @default(PCS)
  itemType             ItemType              @default(PRODUCT)
  ebmSyncStatus        EbmSyncStatus         @default(PENDING)
  ebmSyncedAt          DateTime?
  barcode              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  imageUrl             String?
  id                   Int                   @id @default(autoincrement())
  organizationId       Int
  supplierId           Int?
  isActive             Boolean               @default(true)
  // RRA item classification fields (B2)
  itemClsCd            String? // RRA item classification code (e.g. "5020230302")
  itemCd               String? // Unique item code registered with RRA
  pkgUnitCd            String? // Packaging unit code (e.g. "CT", "BT")
  qtyUnitCd            String? // Quantity unit code (e.g. "U", "KG")
  batches              Batch[]
  inventoryLedgers     InventoryLedger[]
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  purchaseOrderItems   PurchaseOrderItem[]
  saleItems            SaleItem[]
  stockTransferItems   StockTransferItem[]
  stockMovements       StockMovement[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([category])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
  @@index([organizationId, itemType])
  @@index([deletedAt])
  @@map("products")
}

model Customer {
  name           String
  email          String?
  phone          String?
  address        String?
  customerType   CustomerType  @default(INDIVIDUAL)
  balance        Decimal       @default(0) @db.Decimal(10, 2)
  isActive       Boolean       @default(true)
  TIN            String? // RRA Tax ID
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  id             Int           @id @default(autoincrement())
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtPayments   DebtPayment[]
  sales          Sale[]

  @@index([organizationId])
  @@index([phone])
  @@index([organizationId, customerType])
  @@index([deletedAt])
  @@map("customers")
}

model DebtPayment {
  amount         Decimal      @db.Decimal(10, 2)
  paymentDate    DateTime     @default(now())
  paymentMethod  String       @default("CASH")
  reference      String?
  notes          String?
  id             Int          @id @default(autoincrement())
  saleId         Int
  customerId     Int
  organizationId Int
  recordedById   Int
  customer       Customer     @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  recordedBy     User         @relation("RecordedDebtPayments", fields: [recordedById], references: [id])
  sale           Sale         @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([customerId])
  @@index([organizationId])
  @@index([paymentDate])
  @@map("debt_payments")
}

model Sale {
  saleNumber         String           @unique
  paymentType        SalePaymentType
  cashAmount         Decimal          @default(0) @db.Decimal(10, 2)
  insuranceAmount    Decimal          @default(0) @db.Decimal(10, 2)
  debtAmount         Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal          @db.Decimal(10, 2)
  status             SaleStatus       @default(COMPLETED)
  refundedAt         DateTime?        @map("refunded_at")
  refundReason       String?          @map("refund_reason")
  cancelledAt        DateTime?        @map("cancelled_at")
  cancellationReason String?          @map("cancellation_reason")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  id                 Int              @id @default(autoincrement())
  customerId         Int
  userId             Int
  organizationId     Int
  branchId           Int // NEW: Branch association
  refundedById       Int?             @map("refunded_by")
  cancelledById      Int?             @map("cancelled_by")
  originalSaleId     Int?             @map("original_sale_id")
  isProforma         Boolean          @default(false)
  reprintCount       Int              @default(0)
  invoiceNumber      String?          @unique @map("invoice_number")
  vatAmount          Decimal          @default(0) @db.Decimal(10, 2)
  taxableAmount      Decimal          @default(0) @db.Decimal(10, 2)
  rcptLabel          RcptLabel? // RRA receipt type label (B4): NS/NR/CS/CR/TS/TR/PS
  vsdcInvcNo         Int?             @map("vsdc_invc_no") // Raw numeric invoice number sent to VSDC as invcNo (reused as orgInvcNo on refund)
  debtPayments       DebtPayment[]
  ebmQueueItems      EbmQueue[]       @relation("SaleEbmQueue")
  ebmTransactions    EbmTransaction[] @relation("SaleEbmTransactions")
  ebmOutboxItems     EbmOutbox[]
  saleItems          SaleItem[]
  customer           Customer         @relation(fields: [customerId], references: [id])
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch             Branch           @relation(fields: [branchId], references: [id]) // NEW
  originalSale       Sale?            @relation("RefundRelation", fields: [originalSaleId], references: [id])
  refunds            Sale[]           @relation("RefundRelation")
  user             User             @relation(fields: [userId], references: [id])
  salePayments     SalePayment[]

  @@index([organizationId, status, createdAt])
  @@index([invoiceNumber])
  @@index([branchId]) // NEW
  @@index([branchId, createdAt]) // NEW
  @@index([branchId, status]) // NEW
  @@map("sales")
}

model ActivityLog {
  type           ActivityType
  entityType     String?
  entityId       String?
  description    String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  id             Int           @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  branchId       Int? // NEW: Branch association (optional)
  module         LogModule     @default(SYSTEM)
  status         LogStatus     @default(SUCCESS)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch         Branch?       @relation(fields: [branchId], references: [id]) // NEW

  @@index([organizationId, module, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([branchId]) // NEW
  @@map("activity_logs")
}

model SaleItem {
  id                 Int             @id @default(autoincrement())
  saleId             Int
  productId          Int?
  batchId            Int?
  quantity           Int
  unitPrice          Decimal         @db.Decimal(10, 2)
  totalPrice         Decimal         @db.Decimal(10, 2)
  costPrice          Decimal         @default(0) @db.Decimal(10, 2)
  profit             Decimal         @default(0) @db.Decimal(10, 2)
  taxRate            Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(10, 2)
  taxCode            RraTaxCode?
  measurementUnit    MeasurementUnit @default(PCS)
  exemptionReference String?
  dcRate             Decimal         @default(0) @db.Decimal(5, 2) // Discount rate % (B5)
  dcAmt              Decimal         @default(0) @db.Decimal(10, 2) // Discount amount (B5)
  itemType           ItemType        @default(PRODUCT)
  serviceName        String?
  serviceDescription String?

  batch   Batch?   @relation(fields: [batchId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@map("sale_items")
}

model Notification {
  title          String
  message        String
  type           NotificationType @default(GENERIC)
  data           Json?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  id             Int              @id @default(autoincrement())
  organizationId Int
  recipientId    Int?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isRead])
  @@index([recipientId])
  @@index([createdAt])
  @@map("notifications")
}

model StockMovement {
  type           StockMovementType
  quantity       Int
  previousStock  Int
  newStock       Int
  note           String?
  reference      String?
  createdAt      DateTime          @default(now())
  id             Int               @id @default(autoincrement())
  organizationId Int
  productId      Int
  userId         Int
  branchId       Int // NEW: Branch association
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id]) // NEW

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
  @@index([branchId]) // NEW
  @@index([branchId, productId]) // NEW
  @@index([branchId, createdAt]) // NEW
  @@map("stock_movements")
}

model Warehouse {
  id               Int               @id @default(autoincrement())
  name             String
  code             String?
  address          String?
  organizationId   Int
  isActive         Boolean           @default(true)
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  batches          Batch[]
  inventoryLedgers InventoryLedger[]
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("warehouses")
}

model Batch {
  id               Int                @id @default(autoincrement())
  productId        Int
  organizationId   Int
  branchId         Int // NEW: Branch-based inventory
  warehouseId      Int? // DEPRECATED: kept for migration
  batchNumber      String
  quantity         Int
  unitCost         Decimal            @db.Decimal(10, 2)
  expiryDate       DateTime?
  receivedAt       DateTime           @default(now())
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch           Branch             @relation(fields: [branchId], references: [id]) // NEW
  warehouse        Warehouse?         @relation(fields: [warehouseId], references: [id]) // DEPRECATED
  costHistory      CostPriceHistory[]
  inventoryLedgers InventoryLedger[]
  saleItems        SaleItem[]

  @@unique([productId, batchNumber, branchId]) // CHANGED from warehouseId
  @@index([productId, isActive])
  @@index([organizationId])
  @@index([expiryDate])
  @@index([receivedAt])
  @@index([branchId]) // NEW
  @@index([branchId, productId]) // NEW
  @@index([productId, branchId]) // Optimizes product+branch stock lookups
  @@map("batches")
}

