// ─── Supplier Invoice Scanner ──────────────────────────────────────────────

enum SupplierInvoiceStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  IMPORTED
  FAILED
}

enum MatchStatus {
  UNMATCHED
  MATCHED
  MERGED
  NEW
}

enum ImportItemStatus {
  PENDING
  IMPORTED
  SKIPPED
  ERROR
}

model SupplierInvoice {
  id              Int                   @id @default(autoincrement())
  organizationId  Int
  branchId        Int
  supplierId      Int?
  createdById     Int
  invoiceNumber   String?
  invoiceDate     DateTime?
  supplierName    String?
  supplierAddress String?
  currency        String                @default("RWF")
  subtotal        Decimal?              @db.Decimal(15, 2)
  taxAmount       Decimal?              @db.Decimal(15, 2)
  discount        Decimal?              @db.Decimal(15, 2)
  totalAmount     Decimal?              @db.Decimal(15, 2)
  status          SupplierInvoiceStatus @default(DRAFT)
  notes           String?
  importedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // ── Semantic analysis (B: AI extraction + business-intelligence pass) ──
  vendorTIN              String? // RRA/tax ID read off the vendor letterhead — compliance matching
  paymentTerms           String? // e.g. "Net 30", free text as extracted
  dueDate                DateTime?
  poNumber               String? // PO reference as printed on the invoice, if any
  poMatchStatus          PoMatchStatus @default(UNMATCHED)
  matchedPurchaseOrderId Int?
  mathVerified           Boolean       @default(false) // line items + tax - discount reconcile to totalAmount within tolerance
  fraudRiskScore         Int? // 0-100 heuristic score; see invoice-analysis.service.ts
  analysisFlags          Json? // structured findings: math deltas, duplicate lines, fraud reasons, PO diff

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch               Branch                @relation(fields: [branchId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  createdBy            User                  @relation(fields: [createdById], references: [id])
  items                SupplierInvoiceItem[]
  ocrResults           OcrResult[]
  files                SupplierInvoiceFile[]
  importLogs           InvoiceImportLog[]
  matchedPurchaseOrder PurchaseOrder?        @relation("MatchedPurchaseOrder", fields: [matchedPurchaseOrderId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([organizationId, status])
  @@index([matchedPurchaseOrderId])
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id           Int              @id @default(autoincrement())
  invoiceId    Int
  productId    Int?
  productName  String
  description  String?
  sku          String?
  barcode      String?
  batchNumber  String?
  expiryDate   DateTime?
  quantity     Int
  unitPrice    Decimal          @db.Decimal(15, 2)
  sellingPrice Decimal?         @db.Decimal(15, 2)
  totalPrice   Decimal          @db.Decimal(15, 2)
  taxRate      Decimal?         @db.Decimal(5, 2)
  category     String?
  manufacturer String?
  confidence   Float?
  matchStatus  MatchStatus      @default(UNMATCHED)
  importStatus ImportItemStatus @default(PENDING)
  errorMessage String?

  // ── Semantic analysis ──
  taxAmount       Decimal? @db.Decimal(15, 2) // per-line tax, distinct from the header-level taxRate %
  isDuplicate     Boolean  @default(false) // flagged by invoice-analysis.service.ts as a repeated line
  discrepancyNote String? // e.g. "line total != qty * unitPrice"

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("supplier_invoice_items")
}

// ─── AI Invoice Extraction (semantic analysis targets) ─────────────────────

enum PoMatchStatus {
  UNMATCHED // no PO number/candidate found
  MATCHED // PO found and line items reconcile
  PARTIAL // PO found but quantities/amounts differ
  MISMATCHED // PO found but supplier/total materially disagree
}

model SupplierInvoiceFile {
  id           Int      @id @default(autoincrement())
  invoiceId    Int
  originalName String
  storedName   String
  mimeType     String
  fileSize     Int
  filePath     String
  createdAt    DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("supplier_invoice_files")
}

model OcrResult {
  id           Int      @id @default(autoincrement())
  invoiceId    Int
  provider     String
  rawOutput    Json
  parsedData   Json?
  confidence   Float?
  processingMs Int?
  createdAt    DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("ocr_results")
}

model InvoiceImportLog {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  organizationId Int
  branchId       Int
  userId         Int
  totalItems     Int
  importedItems  Int
  skippedItems   Int
  errorItems     Int
  summary        Json?
  createdAt      DateTime @default(now())

  invoice      SupplierInvoice @relation(fields: [invoiceId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id])
  user         User            @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([organizationId])
  @@map("invoice_import_logs")
}
