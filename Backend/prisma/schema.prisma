/// Per-branch, per-receipt-type atomic counter (RRA spec §3.2 — each label has its own sequence).
model BranchReceiptCounter {
  branchId  Int
  rcptLabel RcptLabel
  nextSeq   Int       @default(0)
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, rcptLabel])
  @@map("branch_receipt_counters")
}

/// Per-branch atomic sequence for internal invoice numbers (RRA requires per-device sequences).
model OrganizationInvoiceCounter {
  organizationId Int
  branchId       Int
  nextSequence   Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([organizationId, branchId])
  @@map("organization_invoice_counters")
}

/// Atomic sequence for VSDC invoice numbers (`invcNo`), keyed by the VSDC
/// device (`bhfId`) rather than by branch. RRA requires these numbers to be
/// unique per device, but several branches can share one device, so a
/// per-branch counter can re-emit a number the device already accepted → VSDCMS
/// error 924. Seeding starts past the highest number ever used by the org.
model VsdcDeviceCounter {
  organizationId Int
  deviceKey      String
  nextSequence   Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, deviceKey])
  @@map("vsdc_device_counters")
}

/// Atomic per-organization sequence for the itemCd §4.17 numeric suffix
/// (RW + productTypeDigit + pkgUnitCd + qtyUnitCd + 7-digit sequence).
/// Replaces the earlier count()-based allocation (item-code.service.ts) with
/// a true DB-level increment — same INSERT..ON CONFLICT..RETURNING pattern as
/// VsdcDeviceCounter/OrganizationInvoiceCounter, since Postgres has no native
/// per-key auto-increment. Seeded past the highest sequence already in use so
/// existing itemCd values already registered with RRA are never reissued.
model ProductItemCdCounter {
  organizationId Int
  nextSequence   Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId])
  @@map("product_itemcd_counters")
}

/// Organization-level RRA test purchase codes (single-use, issued per buyer TIN).
/// Configured once at the organization (not per customer/branch) and consumed
/// one-per-business-sale so repeat sales to the same buyer get a fresh code.
model OrganizationPurchaseCode {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  buyerTin       String
  consumed       Boolean      @default(false)
  consumedSaleId Int?         @map("consumed_sale_id")
  createdAt      DateTime     @default(now())
  consumedAt     DateTime?    @map("consumed_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, buyerTin, consumed])
  @@map("organization_purchase_codes")
}

model EbmTransaction {
  id                       Int                 @id @default(autoincrement())
  organizationId           Int
  saleId                   Int?
  invoiceNumber            String?
  ebmInvoiceNumber         String?
  operation                EbmOperation        @default(SALE)
  submissionStatus         EbmSubmissionStatus @default(PENDING)
  submittedAt              DateTime?
  sdcDateTime              DateTime?
  originalEbmInvoiceNumber String?
  idempotencyKey           String?             @unique
  responseData             Json?
  errorMessage             String?
  retryCount               Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  // RRA SDC response fields (B1)
  sdcRcptNo                Int? // "A" half of the required A/B RT receipt counter (VSDC's rcptNo, per receipt-type)
  totalRcptNo              Int? // "B" half of the required A/B RT receipt counter (VSDC's totRcptNo, all receipts)
  sdcId                    String? // VSDC device id returned with the response — needed client-side to build the printed QR string (CIS spec §7.24.7)
  internalData             String?
  receiptSignature         String?
  qrPayload                String?
  rcptLabel                RcptLabel?
  ejSent                   Boolean             @default(false)
  journalText              String?
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale                     Sale?               @relation("SaleEbmTransactions", fields: [saleId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@index([createdAt])
  @@index([submissionStatus])
  @@map("ebm_transactions")
}

model EbmQueue {
