/// Local cache of the RRA VSDC "Codes" master list (/code/selectCodes,
/// RRA checklist §59). One row per (class, code); organised by class so the
/// CIS can populate its own dropdowns/enumerations from the authoritative list.
model RraCode {
  id             Int          @id @default(autoincrement())
  organizationId Int
  cdCls          String // code class, e.g. "04" (payment type), "24" (tax type)
  cdClsNm        String?
  cd             String // the code value
  cdNm           String?
  cdDesc         String?
  useYn          String       @default("Y")
  srtOrd         Int?
  userDfnCd1     String?
  userDfnCd2     String?
  userDfnCd3     String?
  lastSyncedAt   DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, cdCls, cd])
  @@index([organizationId, cdCls])
  @@map("rra_codes")
}

/// Local cache of the RRA VSDC item-classification list / UNSPSC
/// (/itemClass/selectItemsClass, RRA checklist §61). Backs the classification
/// picker shown when creating an item, replacing the hard-coded fallback code.
model RraItemClass {
  id             Int          @id @default(autoincrement())
