generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  name                     String
  businessType             BusinessType                 @default(PHARMACY)
  TIN                      String? // 9-digit RRA Tax Identification Number
  VRN                      String? // VAT Registration Number (for VAT-registered orgs)
  vatRegistered            Boolean                      @default(true) // Business/taxpayer is registered for VAT → product tax categories A/B/C apply; if false every sale uses tax code D
  isTaxExempt              Boolean                      @default(false) // Legally tax-exempt entity (e.g. NGO/diplomatic) → every sale uses tax code A regardless of vatRegistered or product category
  taxExemptionReason       String? // Free-text reason/certificate reference for the exemption
  currency                 String?
  ebmDeviceId              String? // Legacy: org-level fallback (use Branch.ebmDeviceId per branch)
  ebmSerialNo              String? // Legacy: org-level fallback (use Branch.ebmSerialNo per branch)
  avatar                   String?
  address                  String?
  phone                    String?
  email                    String?
  isActive                 Boolean                      @default(true)
  trainingMode             Boolean                      @default(false)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  stripeCustomerId         String?
  id                       Int                          @id @default(autoincrement())
  activityLogs             ActivityLog[]
  batches                  Batch[]
  cashBalances             CashBalance[]
  customers                Customer[]
  debtPayments             DebtPayment[]
  ebmOutbox                EbmOutbox[]
  ebmQueue                 EbmQueue[]
  ebmTransactions          EbmTransaction[]
  expenses                 Expense[]
  inventoryLedgers         InventoryLedger[]
  notifications            Notification[]
  invitations              OrganizationInvitation[]
  products                 Product[]
  purchaseOrders           PurchaseOrder[]
  sales                    Sale[]
  stockMovements           StockMovement[]
  subscriptions            Subscription[]               @relation("OrganizationSubscriptions")
  supplierPayments         SupplierPayment[]
  suppliers                Supplier[]
  userOrganizations        UserOrganization[]
  warehouses               Warehouse[]
  branches                 Branch[] // NEW: Branch management
  taxConfigurations        TaxConfiguration[]
  stockTransfers           StockTransfer[]
  invoiceCounters          OrganizationInvoiceCounter[]
  vsdcDeviceCounters       VsdcDeviceCounter[]
  itemCdCounter            ProductItemCdCounter?
  purchaseCodes            OrganizationPurchaseCode[]
  lastSyncCursor           DateTime?                    @map("last_sync_cursor")
  lastSuccessfulVdsContact DateTime?                    @map("last_successful_vds_contact")
  supplierInvoices         SupplierInvoice[]
  invoiceImportLogs        InvoiceImportLog[]
  settings                 OrganizationSetting?
  supplierAccessTokens     SupplierAccessToken[]
  salePayments             SalePayment[]
  shifts                   Shift[]
  cashMovements            CashMovement[]
  heldSales                HeldSale[]
  devices                  Device[]
  fuelDispensers           FuelDispenser[]
  rraCodes                 RraCode[]
  rraItemClasses           RraItemClass[]
  rraNotices               RraNotice[]
  rraSyncCursors           RraSyncCursor[]
  rraPurchases             RraPurchase[]
  rraImportItems           RraImportItem[]

  @@map("organizations")
}

/// Per-organization workspace customization: sidebar visibility, feature flags, and
/// preferences. Modeled as JSON so new settings ship without a migration (Phase 1 —
/// "Zero-Downtime Adaptability"); each field defaults to `{}` so older rows never
/// need backfilling and the app-layer DEFAULT_SETTINGS fallback stays the source of truth.
model OrganizationSetting {
  id             Int      @id @default(autoincrement())
  organizationId Int      @unique
  sidebarConfig  Json     @default("{}")
  featureFlags   Json     @default("{}")
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// NEW: Branch Model - Core entity for inventory management
model Branch {
  id                   Int          @id @default(autoincrement())
  organizationId       Int
  name                 String
  code                 String // internal code e.g., "KIGALI-01"
  // RRA/EBM per-branch device credentials (each branch has its own VSDC device)
  bhfId                String? // RRA-assigned branch code, e.g. "00", "01"
  ebmDeviceId          String? // VSDC device ID issued per branch by RRA
  ebmSerialNo          String? // VSDC device serial number issued per branch by RRA
  vsdcUrl              String? // Per-branch VSDC endpoint URL (B3)
  // RRA VSDC device initialization (/initializer/selectInitInfo, RRA checklist §58)
  ebmInitializedAt     DateTime?
  ebmInitInfo          Json? // full selectInitInfo response (sdcId, mrcNo, dvcId, last counters, taxpayer/branch metadata)
  location             String?
  address              String?
  addressLine2         String? // Second address line (B3)
  phone                String?
  status               BranchStatus @default(ACTIVE)
  isDefault            Boolean      @default(false)
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  // Running total across every locally-numbered (non-fiscal) receipt on this
  // branch — proforma today, any future local-only type tomorrow. This is the
  // "B" (total counter) in the printed "A/B RT" receipt number (spec §7.25),
  // paired with Sale.localReceiptSeq ("A", the per-type counter).
  localReceiptTotalSeq Int          @default(0) @map("local_receipt_total_seq")

  // Relations
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userBranches      UserBranch[]
  invitations       OrganizationInvitation[]
  sales             Sale[]
  stockMovements    StockMovement[]
  expenses          Expense[]
  cashBalances      CashBalance[]
  cashMovements     CashMovement[]
  activityLogs      ActivityLog[]
  batches           Batch[]
  inventoryLedgers  InventoryLedger[]
  transfersFrom     StockTransfer[]              @relation("TransferFrom")
  transfersTo       StockTransfer[]              @relation("TransferTo")
  purchaseOrders    PurchaseOrder[]
  invoiceCounters   OrganizationInvoiceCounter[]
  receiptCounters   BranchReceiptCounter[]
  supplierInvoices  SupplierInvoice[]
  invoiceImportLogs InvoiceImportLog[]
  shifts            Shift[]
  heldSales         HeldSale[]
  fuelDispensers    FuelDispenser[]

  @@unique([organizationId, bhfId])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@map("branches")
}

// NEW: Junction table linking users to branches (many-to-many)
model UserBranch {
  id        Int      @id @default(autoincrement())
  userId    Int
  branchId  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

model Supplier {
  name                 String
  email                String
  phone                String?
  address              String?
  TIN                  String? // RRA supplier TIN — spplrTin on /trnsPurchase/savePurchases
  contactPerson        String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  id                   Int                   @id @default(autoincrement())
  organizationId       Int
  products             Product[]
  purchaseOrders       PurchaseOrder[]
  supplierInvoices     SupplierInvoice[]
  supplierAccessTokens SupplierAccessToken[]
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("suppliers")
}

model PurchaseOrder {
  orderNumber      String              @unique
  status           PurchaseOrderStatus @default(PENDING)
  totalAmount      Decimal             @db.Decimal(15, 2)
  notes            String?
  orderedAt        DateTime            @default(now())
  expectedDate     DateTime?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  id               Int                 @id @default(autoincrement())
  supplierId       Int
  organizationId   Int
  branchId         Int // NEW Branch-scoped PO
  userId           Int
  isActive         Boolean             @default(true)
  items            PurchaseOrderItem[]
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  supplierPayments SupplierPayment[]
  User             User[]              @relation("CreatedOrders")
  matchedInvoices  SupplierInvoice[]   @relation("MatchedPurchaseOrder")

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([userId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  productName      String
  quantity         Int
  quantityReceived Int           @default(0)
  unitPrice        Decimal       @db.Decimal(15, 2)
  totalPrice       Decimal       @db.Decimal(15, 2)
  taxCode          RraTaxCode?   @default(A)
  taxRate          Decimal?      @db.Decimal(5, 2)
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int?
  product          Product?      @relation(fields: [productId], references: [id])
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model User {
  email                    String                   @unique
  password                 String
  name                     String
  phone                    String?
  profileImage             String?
  role                     UserRole                 @default(ADMIN)
  isActive                 Boolean                  @default(false)
  isEmailVerified          Boolean                  @default(false)
  verificationToken        String?
  verificationExpiry       DateTime?
  passwordResetToken       String?
  passwordResetExpiry      DateTime?
  refreshToken             String?
  refreshTokenExpiry       DateTime?
  requirePasswordChange    Boolean                  @default(false)
  defaultPassword          String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  disabledAt               DateTime?
  reactivatedAt            DateTime?
  id                       Int                      @id @default(autoincrement())
  activityLogs             ActivityLog[]
  recordedCashBalances     CashBalance[]            @relation("RecordedCashBalances")
  recordedCostHistory      CostPriceHistory[]       @relation("RecordedCostHistory")
  recordedDebtPayments     DebtPayment[]            @relation("RecordedDebtPayments")
  recordedExpenses         Expense[]
  inventoryLedgers         InventoryLedger[]
  sentInvitations          OrganizationInvitation[] @relation("InvitedBy")
  receivedInvitations      OrganizationInvitation[] @relation("InvitedUser")
  PurchaseOrder            PurchaseOrder[]
  sales                    Sale[]
  stockMovements           StockMovement[]
  recordedSupplierPayments SupplierPayment[]        @relation("RecordedSupplierPayments")
  userOrganizations        UserOrganization[]
  createdOrders            PurchaseOrder[]          @relation("CreatedOrders")
  userBranches             UserBranch[] // NEW: Branch assignments
  createdInvoices          SupplierInvoice[]
  invoiceImportLogs        InvoiceImportLog[]
  createdSubscriptions     Subscription[]           @relation("SubscriptionCreatedBy")
  shifts                   Shift[]
  shiftsClosed             Shift[]                  @relation("ShiftClosedBy")
  shiftsApproved           Shift[]                  @relation("ShiftApprovedBy")
  cashMovements            CashMovement[]
  heldSales                HeldSale[]
  devices                  Device[]

  @@index([deletedAt])
  @@index([passwordResetToken])
  @@index([refreshToken])
  @@map("users")
}

model UserOrganization {
  role           UserRole
  isOwner        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

model OrganizationInvitation {
  email           String
  role            UserRole
  token           String           @unique
  defaultPassword String
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  id              Int              @id @default(autoincrement())
  organizationId  Int
  branchId        Int? // Optional branch-scoped invitation
  invitedBy       Int
  invitedUserId   Int?
  inviter         User             @relation("InvitedBy", fields: [invitedBy], references: [id])
  invitedUser     User?            @relation("InvitedUser", fields: [invitedUserId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invitedBy])
  @@index([email])
  @@index([branchId])
  @@map("organization_invitations")
}

model SubscriptionPlan {
  name          String         @unique
  description   String?
  price         Float
  currency      String         @default("USD")
  billingCycle  String         @default("MONTHLY")
  isActive      Boolean        @default(true)
  maxUsers      Int            @default(1)
  stripePriceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  id            Int            @id @default(autoincrement())
  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Feature {
  name        String        @unique
  description String?
  key         String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  id          Int           @id @default(autoincrement())
  plans       PlanFeature[]

  @@map("features")
}

model PlanFeature {
  isEnabled  Boolean          @default(true)
  limitValue Int?
  planId     Int
  featureId  Int
  feature    Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  status                    SubscriptionStatus @default(PENDING)
  startDate                 DateTime?
  endDate                   DateTime?
  autoRenew                 Boolean            @default(true)
  paymentMethod             PaymentMethodType  @default(STRIPE)
  paymentId                 String?            @unique
  paymentDetails            Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  cancelledAt               DateTime?
  id                        Int                @id @default(autoincrement())
  organizationId            Int
  planId                    Int
  monthsPurchased           Int?
  billingMode               String             @default("MONTHLY")
  monthlyPrice              Float?
  totalAmount               Float?
  gracePeriodDays           Int                @default(3)
  gracePeriodEndsAt         DateTime?
  createdById               Int?
  renewedFromSubscriptionId Int?
  payments                  Payment[]
  organization              Organization       @relation("OrganizationSubscriptions", fields: [organizationId], references: [id])
  plan                      SubscriptionPlan   @relation(fields: [planId], references: [id])
  createdBy                 User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  renewedFrom               Subscription?      @relation("SubscriptionRenewal", fields: [renewedFromSubscriptionId], references: [id])
  renewals                  Subscription[]     @relation("SubscriptionRenewal")

  @@index([organizationId])
  @@index([status])
  @@index([endDate])
  @@index([gracePeriodEndsAt])
  @@map("subscriptions")
}

model Payment {
  amount           Float
  currency         String               @default("USD")
  paymentMethod    PaymentMethodType
  paymentId        String?
  status           PaymentStatus        @default(PENDING)
  receiptUrl       String?
  metadata         Json?
  processedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  id               Int                  @id @default(autoincrement())
  subscriptionId   Int
  // RRA EBM / VSDC fiscalization for subscription billing receipts.
  invoiceNumber    String?              @map("invoice_number")
  ebmInvoiceNumber String?              @map("ebm_invoice_number")
  submissionStatus EbmSubmissionStatus? @map("submission_status")
  submittedAt      DateTime?            @map("submitted_at")
  sdcDateTime      DateTime?            @map("sdc_date_time")
  sdcId            String?              @map("sdc_id")
  sdcRcptNo        Int?                 @map("sdc_rcpt_no")
  totalRcptNo      Int?                 @map("total_rcpt_no")
  internalData     String?              @map("internal_data")
  receiptSignature String?              @map("receipt_signature")
  qrPayload        String?              @map("qr_payload")
  rcptLabel        RcptLabel?
  errorMessage     String?              @map("error_message")
  retryCount       Int                  @default(0)
  subscription     Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentId])
  @@index([status])
  @@map("payments")
}

model Product {
  name                 String
  sku                  String?
  batchNumber          String?
  quantity             Int                   @default(0)
  unitPrice            Decimal               @db.Decimal(15, 2) // Sales price
  purchasePrice        Decimal?              @db.Decimal(15, 2) // Cost/purchase price — seeds the initial batch's unitCost
  expiryDate           DateTime?
  category             String?
  description          String?
  minStock             Int                   @default(10)
  taxCategory          TaxCategory           @default(STANDARD)
  taxCode              RraTaxCode?
  measurementUnit      MeasurementUnit       @default(PCS)
  itemType             ItemType              @default(PRODUCT)
  ebmSyncStatus        EbmSyncStatus         @default(PENDING)
  ebmSyncedAt          DateTime?
  barcode              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  imageUrl             String?
  id                   Int                   @id @default(autoincrement())
  organizationId       Int
  supplierId           Int?
  isActive             Boolean               @default(true)
  // RRA item classification fields (B2)
  itemClsCd            String? // RRA item classification code (e.g. "5020230302")
  itemCd               String? // Unique item code registered with RRA
  pkgUnitCd            String? // Packaging unit code (e.g. "CT", "BT")
  qtyUnitCd            String? // Quantity unit code (e.g. "U", "KG")
  packagingQty         Int? // Quantity per packaging unit (e.g. 24 pieces per carton)
  origin               String?               @default("RW") // RRA origin country code (ItemSaveReq orgnNatCd, e.g. "RW", "UG")
  useInsurance         Boolean               @default(false) // RRA ItemSaveReq isrcAplcbYn — can this item be billed against a customer's insurance
  itemStandardName     String? // RRA ItemSaveReq itemStdNm — optional standardized item name
  additionalInfo       String? // RRA ItemSaveReq addInfo (max 7 chars)
  l1SalePrice          Decimal?              @db.Decimal(15, 2) // RRA ItemSaveReq grpPrcL1 — price tier 1
  l2SalePrice          Decimal?              @db.Decimal(15, 2) // RRA ItemSaveReq grpPrcL2 — price tier 2
  l3SalePrice          Decimal?              @db.Decimal(15, 2) // RRA ItemSaveReq grpPrcL3 — price tier 3
  l4SalePrice          Decimal?              @db.Decimal(15, 2) // RRA ItemSaveReq grpPrcL4 — price tier 4
  l5SalePrice          Decimal?              @db.Decimal(15, 2) // RRA ItemSaveReq grpPrcL5 — price tier 5
  batches              Batch[]
  inventoryLedgers     InventoryLedger[]
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  purchaseOrderItems   PurchaseOrderItem[]
  saleItems            SaleItem[]
  stockTransferItems   StockTransferItem[]
  stockMovements       StockMovement[]
  supplierInvoiceItems SupplierInvoiceItem[]
  fuelDispensers       FuelDispenser[]

  // RRA itemCd must be unique per taxpayer (VSDC spec §4.17). NULLs (items
  // never synced to EBM) are exempt from a Postgres unique index, so this
  // doesn't block products created before EBM was enabled.
  @@unique([organizationId, itemCd])
  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([category])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
  @@index([organizationId, itemType])
  @@index([deletedAt])
  @@map("products")
}

model Customer {
  name            String
  email           String?
  phone           String?
  address         String?
  customerType    CustomerType  @default(INDIVIDUAL)
  balance         Decimal       @default(0) @db.Decimal(15, 2)
  isActive        Boolean       @default(true)
  TIN             String? // RRA Tax ID
  prcOrdCd        String? // RRA purchase order code (required for B2B / business customer TINs)
  // RRA Customer API (/customers/selectCustomer) verification result
  rraVerifiedName String? // taxprNm returned by RRA for this TIN
  rraTaxprSttsCd  String? // taxpayer status code returned by RRA
  rraVerifiedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  id              Int           @id @default(autoincrement())
  organizationId  Int
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtPayments    DebtPayment[]
  sales           Sale[]

  @@index([organizationId])
  @@index([phone])
  @@index([organizationId, customerType])
  @@index([deletedAt])
  @@map("customers")
}

model DebtPayment {
  amount         Decimal      @db.Decimal(15, 2)
  paymentDate    DateTime     @default(now())
  paymentMethod  String       @default("CASH")
  reference      String?
  notes          String?
  id             Int          @id @default(autoincrement())
  saleId         Int
  customerId     Int
  organizationId Int
  recordedById   Int
  customer       Customer     @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  recordedBy     User         @relation("RecordedDebtPayments", fields: [recordedById], references: [id])
  sale           Sale         @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([customerId])
  @@index([organizationId])
  @@index([paymentDate])
  @@map("debt_payments")
}

model Sale {
  saleNumber           String           @unique
  paymentType          SalePaymentType
  cashAmount           Decimal          @default(0) @db.Decimal(15, 2)
  insuranceAmount      Decimal          @default(0) @db.Decimal(15, 2)
  debtAmount           Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount          Decimal          @db.Decimal(15, 2)
  status               SaleStatus       @default(COMPLETED)
  refundedAt           DateTime?        @map("refunded_at")
  refundReason         String?          @map("refund_reason")
  cancelledAt          DateTime?        @map("cancelled_at")
  cancellationReason   String?          @map("cancellation_reason")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  id                   Int              @id @default(autoincrement())
  customerId           Int
  userId               Int
  organizationId       Int
  branchId             Int // NEW: Branch association
  refundedById         Int?             @map("refunded_by")
  cancelledById        Int?             @map("cancelled_by")
  originalSaleId       Int?             @map("original_sale_id")
  shiftId              Int?             @map("shift_id")
  originHeldSaleId     Int?             @unique @map("origin_held_sale_id")
  // When this (NS) sale was created by converting a proforma, points at that
  // proforma. The proforma itself is kept and moved to status CONVERTED.
  proformaSourceId     Int?             @unique @map("proforma_source_id")
  isProforma           Boolean          @default(false)
  reprintCount         Int              @default(0)
  invoiceNumber        String?          @unique @map("invoice_number")
  vatAmount            Decimal          @default(0) @db.Decimal(15, 2)
  taxableAmount        Decimal          @default(0) @db.Decimal(15, 2)
  rcptLabel            RcptLabel? // RRA receipt type label (B4): NS/NR/CS/CR/TS/TR/PS
  vsdcInvcNo           Int?             @map("vsdc_invc_no") // Raw numeric invoice number sent to VSDC as invcNo (reused as orgInvcNo on refund)
  // Local, non-fiscal per-branch/per-rcptLabel counter (BranchReceiptCounter) —
  // used ONLY for isProforma sales, which are never submitted to VSDC and so
  // never receive a real vsdcInvcNo/sdcRcptNo. This is the "A" in the printed
  // "A/B RT" receipt counter (spec §7.25) — count within this receipt type only.
  localReceiptSeq      Int?             @map("local_receipt_seq")
  // The "B" in "A/B RT" — a running total across every locally-numbered
  // receipt type on this branch (Branch.localReceiptTotalSeq), captured at
  // creation time so it stays fixed even as later local receipts advance the
  // branch's counter further.
  localReceiptTotalSeq Int?             @map("local_receipt_total_seq")
  debtPayments         DebtPayment[]
  ebmQueueItems        EbmQueue[]       @relation("SaleEbmQueue")
  ebmTransactions      EbmTransaction[] @relation("SaleEbmTransactions")
  ebmOutboxItems       EbmOutbox[]
  prcOrdCd             String?          @map("prc_ord_cd") // RRA purchase order code used for this sale (single-use)
  saleItems            SaleItem[]
  customer             Customer         @relation(fields: [customerId], references: [id])
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch               Branch           @relation(fields: [branchId], references: [id]) // NEW
  originalSale         Sale?            @relation("RefundRelation", fields: [originalSaleId], references: [id])
  refunds              Sale[]           @relation("RefundRelation")
  proformaSource       Sale?            @relation("ProformaConversion", fields: [proformaSourceId], references: [id])
  convertedSale        Sale?            @relation("ProformaConversion")
