model Shift {
  id                 Int         @id @default(autoincrement())
  shiftNumber        String?     @unique @map("shift_number")
  organizationId     Int
  branchId           Int
  userId             Int
  deviceId           Int?
  openingFloat       Decimal     @db.Decimal(15, 2)
  openingMobileMoney Decimal     @default(0) @db.Decimal(15, 2)
  openingNotes       String?     @map("opening_notes")
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  closingStartedAt   DateTime?   @map("closing_started_at")
  closingSubmittedAt DateTime?   @map("closing_submitted_at")
  closedById         Int?        @map("closed_by")
  approvedById       Int?        @map("approved_by")
  approvedAt         DateTime?   @map("approved_at")
  approvalDecision   String?     @map("approval_decision")
  approvalReason     String?     @map("approval_reason")
  varianceReason     String?     @map("variance_reason")
  expectedCash       Decimal?    @db.Decimal(15, 2)
  actualCash         Decimal?    @db.Decimal(15, 2)
  actualMobileMoney  Decimal?    @db.Decimal(15, 2)
  difference         Decimal?    @db.Decimal(15, 2)
  cashIn             Decimal?    @db.Decimal(15, 2)
  cashOut            Decimal?    @db.Decimal(15, 2)
  expenseTotal       Decimal?    @db.Decimal(15, 2)
  denominationCounts Json?       @map("denomination_counts")
  closingNotes       String?
  status             ShiftStatus @default(OPEN)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  device        Device?        @relation(fields: [deviceId], references: [id])
  closedBy      User?          @relation("ShiftClosedBy", fields: [closedById], references: [id])
  approvedBy    User?          @relation("ShiftApprovedBy", fields: [approvedById], references: [id])
  sales         Sale[]
  heldSales     HeldSale[]
  cashMovements CashMovement[]
  expenses      Expense[]

  @@index([organizationId, branchId, status])
  @@index([userId, status])
  @@map("shifts")
}

model CashMovement {
  id             Int              @id @default(autoincrement())
  organizationId Int
  branchId       Int
  shiftId        Int
  userId         Int
  type           CashMovementType
