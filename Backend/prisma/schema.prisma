/// Per-branch, per-receipt-type atomic counter (RRA spec §3.2 — each label has its own sequence).
model BranchReceiptCounter {
  branchId  Int
  rcptLabel RcptLabel
  nextSeq   Int       @default(0)
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, rcptLabel])
  @@map("branch_receipt_counters")
}

/// Per-branch atomic sequence for internal invoice numbers (RRA requires per-device sequences).
model OrganizationInvoiceCounter {
  organizationId Int
  branchId       Int
  nextSequence   Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([organizationId, branchId])
  @@map("organization_invoice_counters")
}

model EbmTransaction {
  id                       Int                 @id @default(autoincrement())
  organizationId           Int
  saleId                   Int?
  invoiceNumber            String?
  ebmInvoiceNumber         String?
  operation                EbmOperation        @default(SALE)
  submissionStatus         EbmSubmissionStatus @default(PENDING)
  submittedAt              DateTime?
  sdcDateTime              DateTime?
  originalEbmInvoiceNumber String?
  idempotencyKey           String?             @unique
  responseData             Json?
  errorMessage             String?
  retryCount               Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  // RRA SDC response fields (B1)
  sdcRcptNo                Int? // "A" half of the required A/B RT receipt counter (VSDC's rcptNo, per receipt-type)
  totalRcptNo              Int? // "B" half of the required A/B RT receipt counter (VSDC's totRcptNo, all receipts)
  sdcId                    String? // VSDC device id returned with the response — needed client-side to build the printed QR string (CIS spec §7.24.7)
  internalData             String?
  receiptSignature         String?
  qrPayload                String?
  rcptLabel                RcptLabel?
  ejSent                   Boolean             @default(false)
  journalText              String?
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale                     Sale?               @relation("SaleEbmTransactions", fields: [saleId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@index([createdAt])
  @@index([submissionStatus])
  @@map("ebm_transactions")
}

