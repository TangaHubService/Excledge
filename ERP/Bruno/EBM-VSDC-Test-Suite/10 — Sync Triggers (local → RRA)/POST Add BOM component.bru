meta {
  name: POST Add BOM component
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/inventory/{{organizationId}}/products/{{productId}}/bom
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "componentProductId": "{{componentProductId}}",
    "quantity": 1
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
