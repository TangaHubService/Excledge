meta {
  name: POST Create production run
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/inventory/{{organizationId}}/production/runs
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "productId": "{{productId}}",
    "quantity": 1,
    "branchId": "{{branchId}}"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
