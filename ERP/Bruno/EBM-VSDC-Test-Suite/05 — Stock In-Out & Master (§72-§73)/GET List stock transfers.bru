meta {
  name: GET List stock transfers
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/stock-transfers/{{organizationId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
