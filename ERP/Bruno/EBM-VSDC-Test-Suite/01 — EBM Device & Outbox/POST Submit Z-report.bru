meta {
  name: POST Submit Z-report
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/z-report
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "branchId": "{{branchId}}",
    "rptDe": ""
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

docs {
  rptDe optional (yyyyMMdd). Empty = today.
}
