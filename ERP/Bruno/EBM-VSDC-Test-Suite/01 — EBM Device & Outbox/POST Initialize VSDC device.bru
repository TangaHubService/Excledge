meta {
  name: POST Initialize VSDC device
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/ebm/initialize
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "branchId": "{{branchId}}"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
