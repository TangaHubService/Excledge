meta {
  name: VSDC savePurchases
  type: http
  seq: 12
}

post {
  url: {{vsdcBaseUrl}}/trnsPurchase/savePurchases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tin": "{{ebmTin}}",
    "bhfId": "{{ebmBhfId}}",
    "invcNo": 1,
    "orgInvcNo": 0,
    "spplrTin": "999999992",
    "spplrBhfId": "00",
    "spplrNm": "Supplier",
    "spplrInvcNo": 1,
    "regTyCd": "M",
    "pchsTyCd": "N",
    "rcptTyCd": "P",
    "pmtTyCd": "01",
    "pchsSttsCd": "02",
    "cfmDt": "20261019120000",
    "pchsDt": "20261019",
    "totItemCnt": 1,
    "taxblAmtA": 0,
    "taxblAmtB": 1000,
    "taxblAmtC": 0,
    "taxblAmtD": 0,
    "taxRtA": 0,
    "taxRtB": 18,
    "taxRtC": 0,
    "taxRtD": 0,
    "taxAmtA": 0,
    "taxAmtB": 152.54,
    "taxAmtC": 0,
    "taxAmtD": 0,
    "totTaxblAmt": 1000,
    "totTaxAmt": 152.54,
    "totAmt": 1000,
    "regrId": "Admin",
    "regrNm": "Admin",
    "modrId": "Admin",
    "modrNm": "Admin",
    "itemList": [
      {
        "itemSeq": 1,
        "itemCd": "{{itemCd}}",
        "itemClsCd": "{{itemClsCd}}",
        "itemNm": "Test",
        "pkgUnitCd": "CT",
        "pkg": 1,
        "qtyUnitCd": "U",
        "qty": 1,
        "prc": 1000,
        "splyAmt": 1000,
        "dcRt": 0,
        "dcAmt": 0,
        "taxblAmt": 1000,
        "taxTyCd": "B",
        "taxAmt": 152.54,
        "totAmt": 1000
      }
    ]
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
