meta {
  name: VSDC selectItems
  type: http
  seq: 5
}

post {
  url: {{vsdcBaseUrl}}/items/selectItems
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tin": "{{ebmTin}}",
    "bhfId": "{{ebmBhfId}}",
    "lastReqDt": "20160523000000"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
