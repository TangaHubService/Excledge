meta {
  name: POST Login (saves jwtToken + organizationId)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{loginEmail}}",
    "password": "{{loginPassword}}"
  }
}

script:post-response {
  test('Login 200', () => expect(res.getStatus()).to.equal(200));
  const j = res.getBody();
  const token = j.token || j.data?.token || j.accessToken;
  const org = j.data?.organizationId || j.data?.activeOrganizationId || j.organizationId;
  if (token) bru.setEnvVar('jwtToken', token);
  if (org) bru.setEnvVar('organizationId', String(org));
  console.log('jwt/org', !!token, bru.getEnvVar('organizationId'));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

docs {
  Run first. Saves jwtToken and organizationId.
}
