meta {
  name: POST Approve import (status 3 + stock)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/imports/{importId}/approve
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "itemClsCd": "{{itemClsCd}}",
    "linkProductId": "{{productId}}",
    "createProduct": false,
    "sellingPrice": 2000,
    "expiryDate": "2027-06-30",
    "remark": "Postman approve"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
