meta {
  name: POST Reject import (status 4)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/imports/{importId}/reject
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "remark": "Postman reject"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
