meta {
  name: GET Daily X/Z report
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/reports/daily/{{organizationId}}?branchId={{branchId}}&date=
  body: none
  auth: inherit
}

params:query {
  branchId: {{branchId}}
  date: 
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
