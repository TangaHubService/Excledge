meta {
  name: GET Codes (§59)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/codes?cdCls=
  body: none
  auth: inherit
}

params:query {
  cdCls: 
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
