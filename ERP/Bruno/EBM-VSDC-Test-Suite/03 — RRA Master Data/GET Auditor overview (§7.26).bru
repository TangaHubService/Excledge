meta {
  name: GET Auditor overview (§7.26)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/audit-overview?branchId={{branchId}}
  body: none
  auth: inherit
}

params:query {
  branchId: {{branchId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
