meta {
  name: POST Refund sale (salesSttsCd 05)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/sales/{{saleId}}/refund/{{organizationId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "rfdRsnCd": "06",
    "reason": "Postman refund"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
