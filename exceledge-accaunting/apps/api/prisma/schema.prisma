  bill    ApBill    @relation(fields: [billId], references: [id])

  @@index([billId])
  @@map("ap_allocations")
}

model ApCreditNote {
  id                 String           @id @default(cuid())
  companyId          String
  supplierId         String
  billId             String?
  creditNoteNumber   String
  supplierReference  String?
  noteDate           DateTime
  reason             String
  net                Decimal          @default(0) @db.Decimal(18, 4)
  tax                Decimal          @default(0) @db.Decimal(18, 4)
  gross              Decimal          @default(0) @db.Decimal(18, 4)
  status             ApDocumentStatus @default(POSTED)
  journalId          String?
  description        String?
  createdByErpUserId Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

