// ── Phase 5: Suppliers & Accounts Payable ────────────────────────

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ApDocumentStatus {
  POSTED
  REVERSED
  PENDING_APPROVAL
  REJECTED
}

/// Documents that post on creation unless the company's approval policy holds them for approval
enum ApprovalGateStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED
}

enum ApPaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  CHEQUE
  EFT
}

model Supplier {
  id                        String         @id @default(cuid())
  companyId                 String
  code                      String
  name                      String
  category                  String?
  tin                       String?
  vatNumber                 String?
  registrationNumber        String?
  contactPerson             String?
  telephone                 String?
  mobile                    String?
  email                     String?
  website                   String?
  physicalAddress           String?
  country                   String?
  province                  String?
  district                  String?
  sector                    String?
  cell                      String?
  village                   String?
  currency                  String         @default("RWF")
  paymentTerms              String?
  creditPeriodDays          Int            @default(30)
  apAccountId               String?
  defaultExpenseAccountId   String?
  defaultInventoryAccountId String?
  taxCategory               String?
  whtCategory               String?
  whtRate                   Decimal        @default(0) @db.Decimal(7, 4)
  bankName                  String?
  bankAccountNumber         String?
  branchId                  String?
  costCentre                String?
  status                    SupplierStatus @default(ACTIVE)
  openingBalance            Decimal        @default(0) @db.Decimal(18, 4)
  balance                   Decimal        @default(0) @db.Decimal(18, 4)
  notes                     String?
  externalErpSupplierId     String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bills       ApBill[]
  payments    ApPayment[]
  creditNotes ApCreditNote[]
  debitNotes  ApDebitNote[]
  advances    ApAdvance[]
  ledger      ApLedgerEntry[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, code])
  @@unique([companyId, externalErpSupplierId])
  @@index([companyId, status])
  @@index([companyId, name])
  @@map("suppliers")
}

model ApBill {
  id                    String           @id @default(cuid())
  companyId             String
  supplierId            String
  billNumber            String
  supplierInvoiceNumber String?
  billDate              DateTime
  dueDate               DateTime
  poReference           String?
  grnReference          String?
  status                ApDocumentStatus @default(POSTED)
  currency              String           @default("RWF")
  exchangeRate          Decimal          @default(1) @db.Decimal(18, 8)
  net                   Decimal          @default(0) @db.Decimal(18, 4)
  tax                   Decimal          @default(0) @db.Decimal(18, 4)
  discount              Decimal          @default(0) @db.Decimal(18, 4)
  gross                 Decimal          @default(0) @db.Decimal(18, 4)
  amountPaid            Decimal          @default(0) @db.Decimal(18, 4)
  amountCredited        Decimal          @default(0) @db.Decimal(18, 4)
  expenseAccountId      String?
  description           String?
  journalId             String?
  sourceModule          String?
  sourceDocumentType    String?
  sourceDocumentId      String?
  sourceDocumentNumber  String?
  /// Part of the net amount that cleared goods received not invoiced instead of going to purchases.
  grniCleared           Decimal          @default(0) @db.Decimal(18, 4)
  voidedAt              DateTime?
  voidReason            String?
  voidJournalId         String?
  voidedByErpUserId     Int?
  createdByErpUserId    Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  allocations        ApAllocation[]
  advanceAllocations ApAdvanceAllocation[]
  creditNotes        ApCreditNote[]
  lines              ApBillLine[]

  @@unique([companyId, billNumber])
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@index([companyId, supplierId, status])
  @@index([companyId, dueDate])
  @@index([companyId, sourceDocumentType, sourceDocumentId])
  @@map("ap_bills")
}

model ApBillLine {
  id          String  @id @default(cuid())
  billId      String
  lineNumber  Int
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  net         Decimal @db.Decimal(18, 4)
  taxCode     String?
  taxRate     Decimal @default(0) @db.Decimal(9, 4)
  tax         Decimal @default(0) @db.Decimal(18, 4)
  accountId   String?

  bill ApBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("ap_bill_lines")
}

/// Goods received against a purchase order in the ERP. Its value is already on goods received not
/// invoiced through the PURCHASE stock movements; supplier bills for the order clear it.
model GoodsReceipt {
  id                 String   @id @default(cuid())
  companyId          String
  supplierId         String?
  integrationEventId String?  @unique
  receiptDate        DateTime
  poReference        String?
  reference          String?
  value              Decimal  @db.Decimal(18, 4)
  matchedValue       Decimal  @default(0) @db.Decimal(18, 4)
  createdAt          DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId, supplierId, poReference])
  @@map("goods_receipts")
}

model ApPayment {
  id                 String           @id @default(cuid())
  companyId          String
  supplierId         String
  paymentNumber      String
  paymentDate        DateTime
  method             ApPaymentMethod  @default(BANK)
  amount             Decimal          @db.Decimal(18, 4)
  currency           String           @default("RWF")
  exchangeRate       Decimal          @default(1) @db.Decimal(18, 8)
  withholdingTax     Decimal          @default(0) @db.Decimal(18, 4)
  unallocated        Decimal          @default(0) @db.Decimal(18, 4)
  status             ApDocumentStatus @default(POSTED)
  reference          String?
  journalId          String?
  description        String?
  sourceModule       String?
  sourceDocumentType String?
  sourceDocumentId   String?
  financialAccountId String?
  createdByErpUserId Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  allocations ApAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId, supplierId])
  @@index([companyId, paymentDate])
  @@index([companyId, sourceDocumentType, sourceDocumentId])
