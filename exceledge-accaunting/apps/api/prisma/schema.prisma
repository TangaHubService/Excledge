generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SetupSectionKey {
  COMPANY_PROFILE
  BUSINESS_ACCOUNTING_INFO
  FINANCIAL_YEAR_PERIODS
  CURRENCY
  ACCOUNTING_POLICIES
  LOCALIZATION
  DEFAULT_POSTING_ACCOUNTS
  INVENTORY_SETTINGS
  PARTY_DEFAULTS
  BANKING_PAYMENT
  TRANSACTION_NUMBERING
  APPROVAL_POSTING_CONTROLS
  OPENING_BALANCES
  REVIEW_ACTIVATION
}

enum SetupSectionStatusValue {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REQUIRES_REVIEW
  APPROVED
  CONFIGURATION_ERROR
}

enum ActivationStatus {
  NOT_ACTIVATED
  READY
  ACTIVATED
  CONFIGURATION_ERROR
}

enum PeriodFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

enum PeriodStatus {
  FUTURE
  OPEN
  TEMPORARILY_LOCKED
  CLOSED
  REOPENED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST_OF_SALES
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum AccountingBasis {
  ACCRUAL
  CASH
  MODIFIED_CASH
}

enum ReportingFramework {
  IFRS
  IFRS_SME
  IPSAS
  LOCAL_GAAP
  INTERNAL
}

enum InventoryValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
  SPECIFIC_IDENTIFICATION
}

enum OpeningBalanceBatchStatus {
  DRAFT
  REQUIRES_REVIEW
  APPROVED
  POSTED
  REJECTED
}

/// Accounting company linked to an ERP Organization (identity stays in ERP).
model Company {
  id                       String   @id @default(cuid())
  externalErpOrganizationId String  @unique
  name                     String?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  profile              CompanyProfile?
  businessInfo         BusinessAccountingInfo?
  currencySettings     CurrencySettings?
  policies             AccountingPolicy?
  localization         LocalizationSettings?
  defaultAccounts      DefaultPostingAccounts?
  inventorySettings    InventoryAccountingSettings?
  partyDefaults        PartyDefaults?
  bankingSettings      BankingPaymentSettings?
  approvalControls     ApprovalPostingControls?
  activation           AccountingActivation?
  financialYears       FinancialYear[]
  sectionStatuses      SetupSectionStatus[]
  numberSequences      NumberSequence[]
  accounts             Account[]
  openingBalanceBatches OpeningBalanceBatch[]
  auditEvents          AuditEvent[]
  branches             CompanyBranch[]
  journals             Journal[]
  journalLines         JournalLine[]
  glEntries            GlEntry[]
  integrationEvents    IntegrationEvent[]
  postingExceptions    PostingException[]
  sourceDocumentLinks  SourceDocumentLink[]
  customers            Customer[]
  arInvoices           ArInvoice[]
  arReceipts           ArReceipt[]
  arCreditNotes        ArCreditNote[]
  arDebitNotes         ArDebitNote[]
  arDeposits           ArDeposit[]
  arLedgerEntries      ArLedgerEntry[]
  suppliers            Supplier[]
  apBills              ApBill[]
  apPayments           ApPayment[]
  apCreditNotes        ApCreditNote[]
  apDebitNotes         ApDebitNote[]
  apAdvances           ApAdvance[]
  apLedgerEntries      ApLedgerEntry[]
  inventoryItems       InventoryItem[]
  inventoryLocations   InventoryLocation[]
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  inventoryCostLayers  InventoryCostLayer[]
  financialAccounts    FinancialAccount[]
  bankTransactions     BankTransaction[]
  bankStatements       BankStatement[]
  bankStatementLines   BankStatementLine[]
  bankMatches          BankMatch[]
  bankReconciliations  BankReconciliation[]
  taxCodes             TaxCode[]
  taxSettings          TaxSettings?
  taxPayments          TaxPayment[]
  taxAdjustments       TaxAdjustment[]
  taxFilings           TaxFiling[]
  fiscalDocuments      FiscalDocument[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  recurringExpenses    RecurringExpense[]
  fixedAssetCategories FixedAssetCategory[]
  fixedAssets          FixedAsset[]
  faDepreciationRuns   FixedAssetDepreciationRun[]
  faMaintenances       FixedAssetMaintenance[]
  faTransfers          FixedAssetTransfer[]
  faRevaluations       FixedAssetRevaluation[]
  faImpairments        FixedAssetImpairment[]
  recurringJournals    RecurringJournal[]
  periodCloses         PeriodClose[]
  periodCloseOverrides PeriodCloseOverride[]
  exchangeRates        ExchangeRate[]
  fxRevaluations       FxRevaluation[]
  budgets              Budget[]
  dimensions           Dimension[]
  controlItems         ControlItem[]
  approvalRequests     ApprovalRequest[]
  notifications        Notification[]
  documents            AccountingDocument[]
  importBatches        ImportBatch[]
  ownedGroups          CompanyGroup[]
  groupMemberships     GroupMember[]
  eliminations         Elimination[]
  forecastScenarios    ForecastScenario[]
  anomalyFlags         AnomalyFlag[]
  integrityScans       IntegrityScan[]
  esgMeasures          EsgMeasure[]
  workflowTemplates    WorkflowTemplate[]
  workflowInstances    WorkflowInstance[]
  apiCredentials       ApiCredential[]
  signatures           SignatureRecord[]
  automationJobs       AutomationJob[]
  goodsReceipts        GoodsReceipt[]
  kpiTargets           KpiTarget[]
  risks                RiskItem[]
  controlTests         ControlTest[]
  apiKeyUsage          ApiKeyUsage[]
  webhookEndpoints     WebhookEndpoint[]
  webhookDeliveries    WebhookDelivery[]
  notificationSettings NotificationSettings?
  notificationEmails   NotificationEmail[]

  @@map("companies")
}

model CompanyBranch {
  id                 String   @id @default(cuid())
  companyId          String
  externalErpBranchId String
  name               String?
  code               String?
  /// Inactive branches stay on past postings but cannot be used on new ones
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalErpBranchId])
  @@map("company_branches")
}

model CompanyProfile {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  registeredName        String?
  tradingName           String?
  registrationNumber    String?
  taxIdentificationNumber String?
  logoUrl               String?
  businessEmail         String?
  telephone             String?
  website               String?
  registeredAddress     String?
  operatingAddress      String?
  country               String?
  region                String?
  district              String?
  city                  String?
  postalCode            String?
  industry              String?
  businessActivity      String?
  incorporationDate     DateTime?
  operationsStartDate   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model BusinessAccountingInfo {
  id                       String              @id @default(cuid())
  companyId                String              @unique
  businessType             String?
  legalStructure           String?
  industry                 String?
  accountingCommencementDate DateTime?
  numberOfBranches         Int?
  headOffice               String?
  reportingStructure       String?
  accountingBasis          AccountingBasis     @default(ACCRUAL)
  reportingFramework       ReportingFramework  @default(IFRS_SME)
  defaultLanguage          String              @default("en")
  dateFormat               String              @default("YYYY-MM-DD")
  numberFormat             String              @default("#,##0.00")
  timeZone                 String              @default("Africa/Kigali")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("business_accounting_info")
}

model FinancialYear {
  id                String          @id @default(cuid())
  companyId         String
  name              String
  startDate         DateTime
  endDate           DateTime
  periodFrequency   PeriodFrequency @default(MONTHLY)
  closingPolicy     String?
  transactionLockDate DateTime?
  isCurrent         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periods  AccountingPeriod[]

  @@index([companyId, startDate, endDate])
  @@map("financial_years")
}

model AccountingPeriod {
  id              String       @id @default(cuid())
  financialYearId String
  name            String
  sequence        Int
  startDate       DateTime
  endDate         DateTime
  status          PeriodStatus @default(FUTURE)
  reopenReason    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([financialYearId, sequence])
  @@index([financialYearId, status])
  @@map("accounting_periods")
}

model CurrencySettings {
  id                        String   @id @default(cuid())
  companyId                 String   @unique
  functionalCurrency        String
  reportingCurrency         String?
  multiCurrencyEnabled      Boolean  @default(false)
  currencySymbol            String?
  displayFormat             String?
  decimalPrecision          Int      @default(2)
  exchangeRateSource        String?
  exchangeRateUpdateFrequency String?
  fxGainAccountId           String?
  fxLossAccountId           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("currency_settings")
}

model AccountingPolicy {
  id                         String                   @id @default(cuid())
  companyId                  String                   @unique
  accountingBasis            AccountingBasis          @default(ACCRUAL)
  inventoryValuationMethod   InventoryValuationMethod @default(WEIGHTED_AVERAGE)
  depreciationPolicy         String?
  revenueRecognitionMethod   String?
  expenseRecognitionMethod   String?
  badDebtPolicy              String?
  fxRevaluationPolicy        String?
  documentRetentionPeriod    String?
  materialityThreshold       Decimal?                 @db.Decimal(18, 4)
  roundingPolicy             String?
  periodClosingPolicy        String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("accounting_policies")
}

model LocalizationSettings {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  countryOfRegistration      String
  localizationPackage        String
  taxAuthority               String?
  taxRegistrationNumbers     Json?
  taxpayerCategory           String?
  taxFilingFrequency         String?
  electronicInvoicingRequired Boolean @default(false)
  governmentIntegrationStatus String?
  statutoryReportingRequirements Json?
  payrollCompliancePackage   String?
  defaultTaxCodes            Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("localization_settings")
}

model Account {
  id                         String      @id @default(cuid())
  companyId                  String
  code                       String
  name                       String
  type                       AccountType
  parentId                   String?
  description                String?
  reportingGroup             String?
  isActive                   Boolean     @default(true)
  currency                   String?
  branchId                   String?
  costCentre                 String?
  taxMapping                 String?
  openingBalance             Decimal     @default(0) @db.Decimal(18, 4)
  currentBalance             Decimal     @default(0) @db.Decimal(18, 4)
  systemProtected            Boolean     @default(false)
  allowManualPost            Boolean     @default(true)
  allowAutoPost              Boolean     @default(true)
  bankReconciliationRequired Boolean     @default(false)
  isCashAccount              Boolean     @default(false)
  isTaxAccount               Boolean     @default(false)
  isInventoryAccount         Boolean     @default(false)
  requireApproval            Boolean     @default(false)
  allowNegativeBalance       Boolean     @default(true)
  /// Set true once any posted journal/opening activity references this account (Phase 3+)
  hasPostedTransactions      Boolean     @default(false)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
  journalLines JournalLine[]
  glEntries    GlEntry[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@map("accounts")
}

model DefaultPostingAccounts {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  // Sales / AR
  accountsReceivableId       String?
  salesRevenueId             String?
  serviceRevenueId           String?
  salesDiscountsId           String?
  salesReturnsId             String?
  customerDepositsId         String?
  badDebtExpenseId           String?
  allowanceDoubtfulDebtsId   String?
  // Purchases / AP
  accountsPayableId          String?
  purchasesId                String?
  purchaseDiscountsId        String?
  purchaseReturnsId          String?
  supplierAdvancesId         String?
  accruedExpensesId          String?
  // Cash / Banking
  defaultCashAccountId       String?
  defaultBankAccountId       String?
  pettyCashAccountId         String?
  mobileMoneyClearingId      String?
  undepositedFundsId         String?
  bankChargesId              String?
  interestIncomeId           String?
  paymentProcessingChargesId String?
  // Inventory
  inventoryAssetId           String?
  costOfSalesId              String?
  inventoryAdjustmentId      String?
  inventoryGainId           String?
  inventoryLossId           String?
  inventoryWriteOffId        String?
  grniId                     String?
  goodsInTransitId           String?
  // Taxes
  outputTaxPayableId         String?
  inputTaxReceivableId       String?
  withholdingTaxPayableId    String?
  withholdingTaxReceivableId String?
  payrollTaxPayableId        String?
  otherStatutoryLiabilitiesId String?
  // Payroll
  salariesWagesExpenseId     String?
  payrollPayableId           String?
  employeeBenefitsExpenseId  String?
  employeeDeductionsPayableId String?
  employerContributionsExpenseId String?
  // Fixed assets
  fixedAssetCostId           String?
  accumulatedDepreciationId  String?
  depreciationExpenseId      String?
  assetDisposalId            String?
  gainOnDisposalId           String?
  lossOnDisposalId           String?
  assetRevaluationReserveId  String?
  revaluationLossId          String?
  // General
  retainedEarningsId         String?
  currentYearEarningsId      String?
  suspenseAccountId          String?
  roundingDifferenceId       String?
  fxGainId                   String?
  fxLossId                   String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("default_posting_accounts")
}

model InventoryAccountingSettings {
  id                            String                   @id @default(cuid())
  companyId                     String                   @unique
  valuationMethod               InventoryValuationMethod @default(WEIGHTED_AVERAGE)
  automaticCogsPosting          Boolean                  @default(true)
  negativeInventoryPolicy       String                   @default("PREVENT")
  adjustmentRequiresApproval    Boolean                  @default(true)
  stockCountRequiresApproval    Boolean                  @default(true)
  inventoryAssetAccountId       String?
  costOfSalesAccountId          String?
  adjustmentAccountId           String?
  writeOffAccountId             String?
  gainAccountId                 String?
  lossAccountId                 String?
  grniAccountId                 String?
  goodsInTransitAccountId       String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("inventory_accounting_settings")
}

model PartyDefaults {
  id                        String   @id @default(cuid())
  companyId                 String   @unique
  defaultArAccountId        String?
  customerPaymentTerms      String?
  defaultCreditLimit        Decimal? @db.Decimal(18, 4)
  defaultCustomerCurrency   String?
  defaultSalesTaxCode       String?
  defaultPriceList          String?
  customerNumberingFormat   String?
  creditControlPolicy       String?
  statementDeliveryMethod   String?
  defaultApAccountId        String?
  supplierPaymentTerms      String?
  defaultSupplierCurrency   String?
  defaultPurchaseTaxCode    String?
  supplierNumberingFormat   String?
  withholdingTaxStatus      String?
  supplierPaymentMethod     String?
  supplierApprovalRequired  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("party_defaults")
}

model BankingPaymentSettings {
  id                          String   @id @default(cuid())
  companyId                   String   @unique
  defaultCashAccountId        String?
  defaultBankAccountId        String?
  pettyCashAccountId          String?
  mobileMoneyAccountId        String?
  creditCardClearingAccountId String?
  paymentGatewayClearingId    String?
  undepositedFundsAccountId   String?
  bankChargesAccountId        String?
  interestIncomeAccountId     String?
  defaultReceiptMethod        String?
  defaultPaymentMethod        String?
  bankReconciliationMethod    String?
  paymentMethodAccountMap     Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("banking_payment_settings")
}

model NumberSequence {
  id              String   @id @default(cuid())
  companyId       String
  documentType    String
  prefix          String?
  includeYear     Boolean  @default(true)
  includeMonth    Boolean  @default(false)
  includeBranch   Boolean  @default(false)
  sequenceLength  Int      @default(6)
  startingNumber  Int      @default(1)
  nextNumber      Int      @default(1)
  resetFrequency  String   @default("YEARLY")
  /// Counters never start below this, so numbers issued before per-period counters cannot repeat
  legacyFloor     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counters NumberSequenceCounter[]

  @@unique([companyId, documentType])
  @@map("number_sequences")
}

model NumberSequenceCounter {
  id         String @id @default(cuid())
  sequenceId String
  /// "ALL", "2026" or "2026-03" depending on the sequence's reset frequency
  periodKey  String
  nextNumber Int

  sequence NumberSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, periodKey])
  @@map("number_sequence_counters")
}

model ApprovalPostingControls {
  id                            String   @id @default(cuid())
  companyId                     String   @unique
  automaticPostingEnabled       Boolean  @default(false)
  manualPostingRequired         Boolean  @default(true)
  approvalWorkflowEnabled       Boolean  @default(true)
  approvalLevels                Int      @default(1)
  amountBasedApprovalLimits     Json?
  backdatedTransactionPolicy    String   @default("REQUIRE_APPROVAL")
  futureDatedTransactionPolicy  String   @default("ALLOW")
  transactionEditingPolicy      String   @default("DRAFT_ONLY")
  transactionDeletionPolicy     String   @default("DRAFT_ONLY")
  supportingDocumentRequired    Boolean  @default(false)
  periodLockEnforcement         Boolean  @default(true)
  /// The person who keyed a manual journal cannot post it
  requireDifferentPoster        Boolean  @default(true)
  /// Document types (ApBill, TaxAdjustment, FixedAssetImpairment) whose posting waits for approval
  approvalRequiredFor           String[] @default([])
  /// OFF, WARN or BLOCK: what happens when a posting takes spending over the active budget
  budgetControl                 String   @default("OFF")
  /// Closing a period needs a second person with close:manage to approve the request
  closeApprovalRequired         Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("approval_posting_controls")
}

model OpeningBalanceBatch {
  id          String                    @id @default(cuid())
  companyId   String
  name        String
  status      OpeningBalanceBatchStatus @default(DRAFT)
  notes       String?
  createdByErpUserId  Int?
  approvedByErpUserId Int?
  approvedAt          DateTime?
  journalId           String?
  postedAt            DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   OpeningBalanceLine[]

  @@map("opening_balance_batches")
}

model OpeningBalanceLine {
  id        String   @id @default(cuid())
  batchId   String
  accountId String?
  partyType String?
  partyRef  String?
  memo      String?
  debit     Decimal  @default(0) @db.Decimal(18, 4)
  credit    Decimal  @default(0) @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("opening_balance_lines")
}

model SetupSectionStatus {
  id          String                  @id @default(cuid())
  companyId   String
  sectionKey  SetupSectionKey
  status      SetupSectionStatusValue @default(NOT_STARTED)
  lastError   String?
  updatedByErpUserId Int?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sectionKey])
  @@map("setup_section_statuses")
}

model AccountingActivation {
  id                 String           @id @default(cuid())
  companyId          String           @unique
  status             ActivationStatus @default(NOT_ACTIVATED)
  activatedAt        DateTime?
  activatedByErpUserId Int?
  lastValidationJson Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("accounting_activations")
}

model AuditEvent {
  id           String   @id @default(cuid())
  companyId    String?
  erpUserId    Int
  erpRole      String?
  action       String
  entityType   String
  entityId     String?
  sectionKey   String?
  beforeJson   Json?
  afterJson    Json?
  sourceModule String   @default("ACCOUNTING")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([erpUserId, createdAt])
  @@map("audit_events")
}

enum JournalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  REVERSED
  CANCELLED
  POSTING_FAILED
}

enum JournalType {
  AUTOMATIC
  MANUAL
  OPENING_BALANCE
  REVERSAL
  ADJUSTMENT
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  POSTED
  FAILED
  REJECTED
  DEAD_LETTER
}

enum PostingExceptionStatus {
  OPEN
  RETRYING
  RESOLVED
  DISMISSED
}

model IntegrationEvent {
  id                     String                 @id @default(cuid())
  companyId              String
  eventId                String
  idempotencyKey         String
  eventType              String
  externalOrganizationId String
  externalBranchId       String?
  sourceModule           String
  sourceDocumentType     String
  sourceDocumentId       String
  sourceDocumentNumber   String?
  occurredAt             DateTime
  currencyCode           String
  payload                Json
  status                 IntegrationEventStatus @default(RECEIVED)
  attemptCount           Int                    @default(0)
  lastError              String?
  nextAttemptAt          DateTime               @default(now())
  journalId              String?
  processedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journal Journal? @relation(fields: [journalId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([companyId, eventType])
  @@map("integration_events")
}

model PostingException {
  id                 String                 @id @default(cuid())
  companyId          String
  integrationEventId String?
  journalId          String?
  reason             String
  detailsJson        Json?
  status             PostingExceptionStatus @default(OPEN)
  resolvedAt         DateTime?
  resolvedByErpUserId Int?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("posting_exceptions")
}

model Journal {
  id                   String        @id @default(cuid())
  companyId            String
  journalNumber        String
  journalDate          DateTime
  postingDate          DateTime?
  journalType          JournalType   @default(MANUAL)
  status               JournalStatus @default(DRAFT)
  referenceNumber      String?
  description          String?
  currencyCode         String        @default("RWF")
  exchangeRate         Decimal       @default(1) @db.Decimal(18, 8)
  branchId             String?
  costCentre           String?
  project              String?
  totalDebit           Decimal       @default(0) @db.Decimal(18, 4)
  totalCredit          Decimal       @default(0) @db.Decimal(18, 4)
  createdByErpUserId   Int?
  approvedByErpUserId  Int?
  postedByErpUserId    Int?
  reversedJournalId    String?
  reversesJournalId    String?
  sourceModule         String?
  sourceDocumentType   String?
  sourceDocumentId     String?
  sourceDocumentNumber String?
  integrationEventId   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines              JournalLine[]
  glEntries          GlEntry[]
  integrationEvents  IntegrationEvent[]
  sourceDocumentLinks SourceDocumentLink[]

