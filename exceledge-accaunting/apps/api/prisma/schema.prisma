  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId, supplierId, entryDate])
  @@map("ap_ledger_entries")
}

// ── Phase 6: Inventory accounting ─────────────────────────────────────
// Quantities are owned by the ERP; these tables hold the accounting valuation of every ERP stock movement.

enum InventoryMovementKind {
  OPENING
  PURCHASE
  SALE
  CUSTOMER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  SUPPLIER_RETURN
}

model InventoryItem {
  id                String   @id @default(cuid())
  companyId         String
  externalProductId String
  sku               String?
  name              String
  category          String?
  unit              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances  InventoryBalance[]
  movements InventoryMovement[]
  layers    InventoryCostLayer[]

  @@unique([companyId, externalProductId])
  @@index([companyId, name])
  @@map("inventory_items")
}

model InventoryLocation {
  id               String   @id @default(cuid())
  companyId        String
  externalBranchId String
  name             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances  InventoryBalance[]
  movements InventoryMovement[]
  layers    InventoryCostLayer[]

  @@unique([companyId, externalBranchId])
  @@map("inventory_locations")
}

model InventoryBalance {
  id              String    @id @default(cuid())
  companyId       String
  itemId          String
  locationId      String
  quantity        Decimal   @default(0) @db.Decimal(18, 4)
  value           Decimal   @default(0) @db.Decimal(18, 4)
  erpQuantity     Decimal?  @db.Decimal(18, 4)
  erpQuantityAt   DateTime?
  openingRecorded Boolean   @default(false)
  lastMovementAt  DateTime?
  lastIssueAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([companyId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id                 String                @id @default(cuid())
  companyId          String
  sourceKey          String
  itemId             String
  locationId         String
  kind               InventoryMovementKind
  movementDate       DateTime
  quantityIn         Decimal               @default(0) @db.Decimal(18, 4)
  quantityOut        Decimal               @default(0) @db.Decimal(18, 4)
  unitCost           Decimal               @default(0) @db.Decimal(18, 4)
  value              Decimal               @default(0) @db.Decimal(18, 4)
  quantityAfter      Decimal               @db.Decimal(18, 4)
  valueAfter         Decimal               @db.Decimal(18, 4)
  costSource         String
  erpMovementType    String?
  erpLedgerId        String?
  erpQuantityAfter   Decimal?              @db.Decimal(18, 4)
  reference          String?
  referenceType      String?
  batchNumber        String?
  note               String?
  integrationEventId String?
  journalId          String?
  /// Sales recorded before cost of sales came from valuation; their cost is in the sale journal.
  costInSaleJournal  Boolean               @default(false)
  createdAt          DateTime              @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([companyId, sourceKey])
  @@index([companyId, movementDate])
  @@index([companyId, kind, movementDate])
  @@index([itemId, locationId, movementDate])
  @@index([integrationEventId])
  @@index([reference, itemId])
  @@map("inventory_movements")
}

model InventoryCostLayer {
  id         String   @id @default(cuid())
  companyId  String
  itemId     String
  locationId String
  movementId String
  receivedAt DateTime
  quantity   Decimal  @db.Decimal(18, 4)
  remaining  Decimal  @db.Decimal(18, 4)
  unitCost   Decimal  @db.Decimal(18, 4)
  createdAt  DateTime @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([itemId, locationId, receivedAt])
  @@map("inventory_cost_layers")
}

// ── Phase 7: Banking & reconciliation ─────────────────────────────

enum FinancialAccountKind {
  BANK
  CASH
  PETTY_CASH
  MOBILE_MONEY
}

enum BankTransactionKind {
  RECEIPT
  PAYMENT
  TRANSFER
  BANK_CHARGE
  INTEREST
  CASH_COUNT
}

enum BankTransactionStatus {
  POSTED
  REVERSED
}

enum BankReconciliationStatus {
  DRAFT
  REVIEWED
  APPROVED
  COMPLETED
}

/// A bank, cash, petty cash or mobile money account. Balance and cashbook come from its GL account.
model FinancialAccount {
  id                 String               @id @default(cuid())
  companyId          String
  kind               FinancialAccountKind
  name               String
  accountNumber      String?
  bankName           String?
  branchName         String?
  swiftCode          String?
  provider           String?
  currency           String               @default("RWF")
  glAccountId        String
  openingBalance     Decimal              @default(0) @db.Decimal(18, 4)
  dateOpened         DateTime
  /// GL entries dated before this are treated as already cleared by the bank.
  reconcileFrom      DateTime
  isActive           Boolean              @default(true)
  allowOverdraft     Boolean              @default(false)
  custodian          String?
  notes              String?
  createdByErpUserId Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]    @relation("BankTransactionAccount")
  transfersIn      BankTransaction[]    @relation("BankTransactionCounterAccount")
  statements       BankStatement[]
  reconciliations  BankReconciliation[]

  @@unique([companyId, glAccountId])
  @@unique([companyId, name])
  @@index([companyId, kind])
  @@map("financial_accounts")
}

model BankTransaction {
  id                        String                @id @default(cuid())
  companyId                 String
  number                    String
  kind                      BankTransactionKind
  transferType              String?
  financialAccountId        String
  counterFinancialAccountId String?
  transactionDate           DateTime
  amount                    Decimal               @db.Decimal(18, 4)
  fee                       Decimal               @default(0) @db.Decimal(18, 4)
  method                    String?
  reference                 String?
  chequeNumber              String?
  partyType                 String?
  partyName                 String?
  /// Set when the money was received from a customer or paid to a supplier through their control account.
  customerId                String?
  supplierId                String?
  arReceiptId               String?
  apPaymentId               String?
  description               String?
  /// Account lines chosen by the user: [{ accountId, amount, description }]
  lines                     Json?
  countedAmount             Decimal?              @db.Decimal(18, 4)
  bookAmount                Decimal?              @db.Decimal(18, 4)
  statementLineId           String?
  status                    BankTransactionStatus @default(POSTED)
  journalId                 String?
  reversalJournalId         String?
  reversedAt                DateTime?
  reversedByErpUserId       Int?
  reversalReason            String?
  createdByErpUserId        Int?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount  @relation("BankTransactionAccount", fields: [financialAccountId], references: [id])
  counterAccount   FinancialAccount? @relation("BankTransactionCounterAccount", fields: [counterFinancialAccountId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, financialAccountId, transactionDate])
  @@index([companyId, kind])
  @@map("bank_transactions")
}

model BankStatement {
  id                  String    @id @default(cuid())
  companyId           String
  financialAccountId  String
  fileName            String
  format              String
  periodStart         DateTime?
  periodEnd           DateTime?
  openingBalance      Decimal?  @db.Decimal(18, 4)
  closingBalance      Decimal?  @db.Decimal(18, 4)
  lineCount           Int       @default(0)
  duplicateCount      Int       @default(0)
  errorCount          Int       @default(0)
  importedByErpUserId Int?
  createdAt           DateTime  @default(now())

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount    @relation(fields: [financialAccountId], references: [id])
  lines            BankStatementLine[]

  @@index([companyId, financialAccountId])
  @@map("bank_statements")
}

/// Amount is from the bank's side: positive for money in, negative for money out.
model BankStatementLine {
  id                 String    @id @default(cuid())
  companyId          String
  statementId        String
  financialAccountId String
  lineNumber         Int
  transactionDate    DateTime
  valueDate          DateTime?
  description        String
  reference          String?
  chequeNumber       String?
  amount             Decimal   @db.Decimal(18, 4)
  runningBalance     Decimal?  @db.Decimal(18, 4)
  fingerprint        String
  matchId            String?
  createdAt          DateTime  @default(now())

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  match     BankMatch?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([financialAccountId, fingerprint])
  @@index([companyId, financialAccountId, transactionDate])
  @@index([matchId])
  @@map("bank_statement_lines")
}

/// Groups statement lines and GL entries whose totals agree. Locked once its reconciliation completes.
model BankMatch {
  id                 String   @id @default(cuid())
  companyId          String
  financialAccountId String
  method             String
  clearedDate        DateTime
  reconciliationId   String?
  createdByErpUserId Int?
  createdAt          DateTime @default(now())

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   BankStatementLine[]
  entries BankMatchEntry[]

  @@index([companyId, financialAccountId])
  @@index([reconciliationId])
  @@map("bank_matches")
}

model BankMatchEntry {
  id        String   @id @default(cuid())
  matchId   String
  glEntryId String   @unique
  amount    Decimal  @db.Decimal(18, 4)
  entryDate DateTime

  match BankMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("bank_match_entries")
}

model BankReconciliation {
  id                   String                   @id @default(cuid())
  companyId            String
  financialAccountId   String
  number               String
  statementDate        DateTime
  statementBalance     Decimal                  @db.Decimal(18, 4)
  status               BankReconciliationStatus @default(DRAFT)
  bookBalance          Decimal?                 @db.Decimal(18, 4)
  difference           Decimal?                 @db.Decimal(18, 4)
  summary              Json?
  notes                String?
  preparedByErpUserId  Int?
  preparedAt           DateTime                 @default(now())
  reviewedByErpUserId  Int?
  reviewedAt           DateTime?
  approvedByErpUserId  Int?
  approvedAt           DateTime?
  completedByErpUserId Int?
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, financialAccountId, statementDate])
  @@map("bank_reconciliations")
}

// ── Phase 8: Tax management ───────────────────────────────

enum TaxType {
  OUTPUT_VAT
  INPUT_VAT
  ZERO_RATED
  EXEMPT
  WHT_PAYABLE
  WHT_RECEIVABLE
  EXCISE
  IMPORT_VAT
  PAYE
  OTHER
}

enum TaxFilingKind {
  VAT
  WHT
  PAYE
  EXCISE
  ANNUAL
}

enum TaxFilingStatus {
  DRAFT
  PREPARED
  FILED
}

enum TaxPaymentStatus {
  POSTED
  REVERSED
}

/// Company tax settings. Rates live on TaxCode; this only holds registration and filing preferences.
model TaxSettings {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  taxAuthority         String?
  tin                  String?
  vatRegistered        Boolean  @default(false)
  vatFilingFrequency   String?
  taxCurrency          String   @default("RWF")
  roundingMethod       String?
  defaultOutputTaxCodeId String?
  defaultInputTaxCodeId  String?
  defaultWhtTaxCodeId    String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("tax_settings")
}

/// A tax code the company has configured. Rate is stored and applied; Accounting never invents a statutory rate.
model TaxCode {
  id            String    @id @default(cuid())
  companyId     String
  code          String
  name          String
  taxType       TaxType
  ratePercent   Decimal   @db.Decimal(9, 4)
  glAccountId   String?
  authority     String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  appliesTo     String?
  notes         String?
  createdByErpUserId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, taxType, isActive])
  @@map("tax_codes")
}

model TaxPayment {
  id                 String           @id @default(cuid())
  companyId          String
  number             String
  paymentDate        DateTime
  taxType            TaxType
  taxCodeId          String?
  taxAccountId       String
  bankAccountId      String
  financialAccountId String?
  amount             Decimal          @db.Decimal(18, 4)
  isRefund           Boolean          @default(false)
  reference          String?
  description        String?
  periodFrom         DateTime?
  periodTo           DateTime?
  filingId           String?
  status             TaxPaymentStatus @default(POSTED)
  journalId          String?
  reversalJournalId  String?
  reversedAt         DateTime?
  reversedByErpUserId Int?
  reversalReason     String?
  createdByErpUserId Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, paymentDate])
  @@index([companyId, taxType])
  @@map("tax_payments")
}

model TaxAdjustment {
  id                 String   @id @default(cuid())
  companyId          String
  number             String
  adjustmentDate     DateTime
  taxType            TaxType
  taxCodeId          String?
  taxAccountId       String
  contraAccountId    String
  amount             Decimal  @db.Decimal(18, 4)
  /// true = increase the tax liability / decrease recoverable; false = the opposite
  increasesLiability Boolean  @default(true)
  reason             String
  reference          String?
  status             ApprovalGateStatus @default(POSTED)
  journalId          String?
  createdByErpUserId Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, adjustmentDate])
  @@map("tax_adjustments")
}

model TaxFiling {
  id                 String          @id @default(cuid())
  companyId          String
  number             String
  kind               TaxFilingKind
  status             TaxFilingStatus @default(DRAFT)
  periodFrom         DateTime
  periodTo           DateTime
  dueDate            DateTime?
  preparedAt         DateTime?
  preparedByErpUserId Int?
  filedAt            DateTime?
  filedByErpUserId   Int?
  filingReference    String?
  /// Snapshot of the return figures at prepare/file time
  summary            Json?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, kind, periodFrom])
  @@map("tax_filings")
}

/// Fiscal invoice / receipt details recorded from Excel Edge EBM (read-only linkage; ERP owns transmission).
model FiscalDocument {
  id                   String   @id @default(cuid())
  companyId            String
  sourceDocumentType   String
  sourceDocumentId     String
  sourceDocumentNumber String?
  occurredAt           DateTime
  netAmount            Decimal  @db.Decimal(18, 4)
  taxAmount            Decimal  @db.Decimal(18, 4)
  grossAmount          Decimal  @db.Decimal(18, 4)
  currencyCode         String   @default("RWF")
  vsdcInvoiceNumber    String?
  sdcReceiptNumber     String?
  receiptSignature     String?
  internalData         String?
  qrCode               String?
  journalId            String?
  integrationEventId   String?
  metadata             Json?
  createdAt            DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sourceDocumentType, sourceDocumentId])
  @@index([companyId, occurredAt])
  @@map("fiscal_documents")
}

// Phase 9: Expense management

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  REVERSED
}

enum ExpensePaymentMode {
  IMMEDIATE
  ON_ACCOUNT
  REIMBURSEMENT
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model ExpenseCategory {
  id                 String   @id @default(cuid())
  companyId          String
  code               String
  name               String
  glAccountId        String?
  isActive           Boolean  @default(true)
  notes              String?
  createdByErpUserId Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("expense_categories")
}

model Expense {
  id                   String             @id @default(cuid())
  companyId            String
  number               String
  expenseDate          DateTime
  categoryId           String
  expenseAccountId     String
  paymentMode          ExpensePaymentMode @default(IMMEDIATE)
  status               ExpenseStatus      @default(DRAFT)
  payeeName            String?
  supplierId           String?
  employeeErpUserId    Int?
  employeeName         String?
  description          String?
  netAmount            Decimal            @db.Decimal(18, 4)
  taxAmount            Decimal            @default(0) @db.Decimal(18, 4)
  grossAmount          Decimal            @db.Decimal(18, 4)
  taxCodeId            String?
  currencyCode         String             @default("RWF")
  /// Bank/cash GL for IMMEDIATE/REIMBURSEMENT; AP or accrued for ON_ACCOUNT
  creditAccountId      String?
  financialAccountId   String?
  paymentMethod        String?
  reference            String?
  branch               String?
  department           String?
  costCentre           String?
  project              String?
  receiptReference     String?
  rejectionReason      String?
  submittedAt          DateTime?
  submittedByErpUserId Int?
  approvedAt           DateTime?
  approvedByErpUserId  Int?
  rejectedAt           DateTime?
  rejectedByErpUserId  Int?
  postedAt             DateTime?
  postedByErpUserId    Int?
  journalId            String?
  reversalJournalId    String?
  reversedAt           DateTime?
  reversedByErpUserId  Int?
  reversalReason       String?
  recurringExpenseId   String?
  sourceDocumentType   String?
  sourceDocumentId     String?
  createdByErpUserId   Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         ExpenseCategory   @relation(fields: [categoryId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  allocations      ExpenseAllocation[]

  @@unique([companyId, number])
  @@index([companyId, expenseDate])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, sourceDocumentType, sourceDocumentId])
  @@map("expenses")
}

model ExpenseAllocation {
  id          String  @id @default(cuid())
  expenseId   String
  companyId   String
  branch      String?
  department  String?
  costCentre  String?
  project     String?
  amount      Decimal @db.Decimal(18, 4)
  percent     Decimal @db.Decimal(8, 4)
  notes       String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_allocations")
}

model RecurringExpense {
  id                 String              @id @default(cuid())
  companyId          String
  number             String
  name               String
  categoryId         String
  expenseAccountId   String?
  paymentMode        ExpensePaymentMode  @default(IMMEDIATE)
  frequency          RecurringFrequency
  amount             Decimal             @db.Decimal(18, 4)
  taxAmount          Decimal             @default(0) @db.Decimal(18, 4)
  payeeName          String?
  supplierId         String?
  creditAccountId    String?
  financialAccountId String?
  description        String?
  branch             String?
  department         String?
  costCentre         String?
  project            String?
  startDate          DateTime
  endDate            DateTime?
  nextRunDate        DateTime
  lastGeneratedAt    DateTime?
  autoPost           Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdByErpUserId Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, number])
  @@index([companyId, nextRunDate, isActive])
  @@map("recurring_expenses")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  SUM_OF_YEARS_DIGITS
  UNITS_OF_PRODUCTION
}

enum DepreciationFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum AssetStatus {
  REGISTERED
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

enum DisposalMethod {
  SALE
  SCRAP
  DONATION
  THEFT
  DESTRUCTION
  RETIREMENT
}

enum AssetAcquisitionMethod {
  PURCHASE
  CAPITALIZATION
  DONATION
  TRANSFER
  OTHER
}

model FixedAssetCategory {
  id                     String             @id @default(cuid())
  companyId              String
  code                   String
  name                   String
  usefulLifeMonths       Int                @default(0)
  depreciationMethod     DepreciationMethod @default(STRAIGHT_LINE)
  residualPercent        Decimal            @default(0) @db.Decimal(9, 4)
  ratePercent            Decimal?           @db.Decimal(9, 4)
  assetAccountId         String?
  accumDepAccountId      String?
  depExpenseAccountId    String?
  isActive               Boolean            @default(true)
  notes                  String?
  createdByErpUserId     Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets  FixedAsset[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("fixed_asset_categories")
}

model FixedAsset {
  id                      String                  @id @default(cuid())
  companyId               String
  number                  String
  name                    String
  categoryId              String
  serialNumber            String?
  barcode                 String?
  description             String?
  supplierId              String?
  supplierName            String?
  purchaseDate            DateTime?
  acquisitionCost         Decimal                 @db.Decimal(18, 4)
  currencyCode            String                  @default("RWF")
  acquisitionMethod       AssetAcquisitionMethod  @default(PURCHASE)
  residualValue           Decimal                 @default(0) @db.Decimal(18, 4)
  usefulLifeMonths        Int                     @default(0)
  depreciationMethod      DepreciationMethod      @default(STRAIGHT_LINE)
  depreciationFrequency   DepreciationFrequency   @default(MONTHLY)
  ratePercent             Decimal?                @db.Decimal(9, 4)
  totalUnits              Decimal?                @db.Decimal(18, 4)
  unitsDepreciated        Decimal                 @default(0) @db.Decimal(18, 4)
  depreciatedMonths       Int                     @default(0)
  depreciationBase        Decimal?                @db.Decimal(18, 4)
  depreciationBaseMonth   Int                     @default(0)
  revaluationSurplus      Decimal                 @default(0) @db.Decimal(18, 4)
  revaluationLossInPl     Decimal                 @default(0) @db.Decimal(18, 4)
  assetAccountId          String?
  accumDepAccountId       String?
  depExpenseAccountId     String?
  creditAccountId         String?
  branch                  String?
  department              String?
  costCentre              String?
  project                 String?
  location                String?
  assignedEmployee        String?
  warrantyExpiry          DateTime?
  insuranceDetails        String?
  status                  AssetStatus             @default(REGISTERED)
  capitalizedAt           DateTime?
  capitalizationJournalId String?
  accumulatedDepreciation Decimal                 @default(0) @db.Decimal(18, 4)
  lastDepreciationPeriod  String?
  disposedAt              DateTime?
  disposalMethod          DisposalMethod?
  disposalProceeds        Decimal?                @db.Decimal(18, 4)
  disposalJournalId       String?
  disposalNotes           String?
  sourceDocumentType      String?
  sourceDocumentId        String?
  createdByErpUserId      Int?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  company        Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       FixedAssetCategory          @relation(fields: [categoryId], references: [id])
  depreciations  FixedAssetDepreciation[]
  maintenances   FixedAssetMaintenance[]
  transfers      FixedAssetTransfer[]
  revaluations   FixedAssetRevaluation[]
  impairments    FixedAssetImpairment[]
  usages         FixedAssetUsage[]

