  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  companyId      String
  endpointId     String
  event          String
  payload        Json
  /// PENDING, DELIVERED or FAILED (gave up)
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// Short-lived lease so only one API instance runs a scheduled job at a time.
model JobLock {
  key       String   @id
  holder    String
  expiresAt DateTime

  @@map("job_locks")
}

model SignatureRecord {
  id                String   @id @default(cuid())
  companyId         String
  entityType        String
  entityId          String
  statement         String
  signerErpUserId   Int
  signerErpRole     String?
  /// SHA-256 of the canonical JSON snapshot of the record when signed; null on signatures made before hashing
  contentHash       String?
  snapshot          Json?
  /// SHA-256 over the signature itself (record, statement, signer, time, content hash)
  signatureHash     String?
  /// Set when the signature was given by deciding an approval
  approvalRequestId String?
  signedAt          DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@map("signature_records")
}

model AutomationJob {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  jobType     String
  schedule    String
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("automation_jobs")
}
