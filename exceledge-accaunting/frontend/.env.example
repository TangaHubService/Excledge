# Main Excel Edge ERP web app. Used for the "Continue with my Excel Edge session"
# handoff, "Forgot password" and the link back to Excel Edge.
# Local: http://localhost:5173 | Production: https://erp.exceledgecpa.com
VITE_ERP_URL=https://erp.exceledgecpa.com

# Excel Edge ERP API (email sign-in). The ERP API lives on its own subdomain,
# so always set this explicitly — it does NOT default correctly from VITE_ERP_URL.
# Local: http://localhost:4500/api | Production: https://erpapi.exceledgecpa.com/api
VITE_ERP_API_URL=https://erpapi.exceledgecpa.com/api

# Accounting API the Vite dev server proxies /api and /health to (dev only).
ACCOUNTING_API_PROXY_TARGET=http://localhost:4600

# Accounting API base for production builds. Leave empty when the web app and
# the API share one origin (https://api.exceledgecpa.com proxies /api to the
# API server). Set an absolute URL only if the API lives elsewhere.
# VITE_ACCOUNTING_API_URL=https://api.exceledgecpa.com
