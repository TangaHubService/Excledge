{
  "info": {
    "_postman_id": "excledge-ebm-test",
    "name": "Excledge EBM/VSDC Test Suite",
    "description": "Postman collection for testing the RRA EBM/VSDC integration. Requires the backend server running on port 4500 and the VSDC sandbox on port 8085.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Get JWT Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"enockiradukunda4@gmail.com\",\n  \"password\": \"Kigali@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\nif (pm.response.code === 200) {\n    var jsonData = pm.response.json();\n    pm.environment.set(\"jwtToken\", jsonData.token || jsonData.data?.token || jsonData.accessToken);\n    pm.environment.set(\"organizationId\", jsonData.data?.organizationId || jsonData.data?.activeOrganizationId || 1);\n    console.log(\"JWT Token saved: \" + (pm.environment.get(\"jwtToken\") || \"not found\"));\n    console.log(\"Organization ID: \" + (pm.environment.get(\"organizationId\") || \"not found\"));\n}",
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
