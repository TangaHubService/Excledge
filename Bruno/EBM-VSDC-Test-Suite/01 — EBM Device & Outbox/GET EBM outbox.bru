meta {
  name: GET EBM outbox
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/ebm-outbox?status=&limit=50
  body: none
  auth: inherit
}

params:query {
  status: 
  limit: 50
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
  const d = res.getBody()?.data ?? res.getBody();
  const list = d?.entries || d?.items || d || [];
  const first = Array.isArray(list) ? list[0] : null;
  if (first?.id) bru.setEnvVar('outboxId', String(first.id));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
