meta {
  name: GET List imports (includes supplier name)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/imports
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
  const d = res.getBody()?.data ?? res.getBody();
  const list = d?.imports || [];
  test('spplrNm field present', () => { if (list.length) expect(list[0]).to.have.property('spplrNm'); });
  const im = list.find(x => x.status === 'PENDING') || list[0];
  if (im?.id) {
    bru.setEnvVar('importId', String(im.id));
    console.log('importId', im.id, 'supplier', im.spplrNm, 'item', im.itemNm);
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
