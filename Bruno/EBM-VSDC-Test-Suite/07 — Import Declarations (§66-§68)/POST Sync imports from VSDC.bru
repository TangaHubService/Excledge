meta {
  name: POST Sync imports from VSDC
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/imports/sync
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "requestDate": ""
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

docs {
  requestDate optional; must be later than last request when set.
}
