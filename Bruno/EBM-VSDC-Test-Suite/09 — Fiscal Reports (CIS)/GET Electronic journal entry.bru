meta {
  name: GET Electronic journal entry
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/reports/electronic-journal/{{organizationId}}/{{saleId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
