meta {
  name: PATCH Organization settings
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/settings
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "featureFlags": {
      "ebmIntegrationEnabled": true
    }
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
