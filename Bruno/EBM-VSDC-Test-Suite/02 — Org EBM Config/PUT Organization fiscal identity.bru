meta {
  name: PUT Organization fiscal identity
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/organizations/{{organizationId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "TIN": "{{ebmTin}}",
    "name": "{{orgName}}",
    "address": "{{orgAddress}}"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
