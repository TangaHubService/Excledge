meta {
  name: POST Create product (queues saveItems)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/inventory/{{organizationId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "name": "EBM Test Product",
    "unitPrice": 1180,
    "taxCode": "B",
    "itemType": "PRODUCT",
    "itemClsCd": "{{itemClsCd}}",
    "pkgUnitCd": "CT",
    "qtyUnitCd": "U"
  }
}

script:post-response {
  test('created-ish', () => expect(res.getStatus()).to.be.below(500));
  const j = res.getBody();
  const id = j?.data?.id || j?.product?.id || j?.id;
  if (id) bru.setEnvVar('productId', String(id));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
