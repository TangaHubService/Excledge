meta {
  name: POST Sync one product to VSDC
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/items/{productId}/sync
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
