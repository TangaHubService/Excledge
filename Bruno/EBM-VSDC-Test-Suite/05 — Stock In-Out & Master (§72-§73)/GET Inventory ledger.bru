meta {
  name: GET Inventory ledger
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/inventory/{{organizationId}}/ledger?productId={{productId}}&limit=50
  body: none
  auth: inherit
}

params:query {
  productId: {{productId}}
  limit: 50
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
