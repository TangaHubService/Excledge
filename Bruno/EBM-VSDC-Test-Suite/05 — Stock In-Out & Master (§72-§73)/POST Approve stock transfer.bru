meta {
  name: POST Approve stock transfer
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/stock-transfers/{{organizationId}}/{{transferId}}/approve
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
