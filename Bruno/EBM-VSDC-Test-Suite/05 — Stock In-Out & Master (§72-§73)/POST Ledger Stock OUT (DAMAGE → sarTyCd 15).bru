meta {
  name: POST Ledger Stock OUT (DAMAGE → sarTyCd 15)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/inventory/{{organizationId}}/ledger/out
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "productId": "{{productId}}",
    "quantity": 1,
    "movementType": "DAMAGE",
    "branchId": "{{branchId}}",
    "note": "Postman damage"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
