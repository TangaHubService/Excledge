meta {
  name: POST Ledger Adjustment (± → 06/16)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/inventory/{{organizationId}}/ledger/adjustment
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "productId": "{{productId}}",
    "quantity": 2,
    "branchId": "{{branchId}}",
    "note": "Postman adjust"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
