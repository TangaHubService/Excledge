meta {
  name: GET List purchases (PENDING)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/purchases?status=PENDING
  body: none
  auth: inherit
}

params:query {
  status: PENDING
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
  const d = res.getBody()?.data ?? res.getBody();
  const list = d?.purchases || [];
  if (list[0]?.id) bru.setEnvVar('purchaseId', String(list[0].id));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
