meta {
  name: POST Reject purchase (04 Canceled)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/purchases/{purchaseId}/confirm?reject=true
  body: json
  auth: inherit
}

params:query {
  reject: true
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "reject": true,
    "remark": "Goods not accepted"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

docs {
  savePurchases pchsSttsCd=04. No stock.
}
