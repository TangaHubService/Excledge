meta {
  name: GET List purchases
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/organizations/{{organizationId}}/rra/purchases
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
  const d = res.getBody()?.data ?? res.getBody();
  const list = d?.purchases || [];
  const p = list.find(x => x.status === 'PENDING') || list[0];
  if (p?.id) {
    bru.setEnvVar('purchaseId', String(p.id));
    console.log('purchaseId', p.id, 'supplier', p.spplrNm, 'status', p.status);
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
