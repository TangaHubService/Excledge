meta {
  name: POST Cancel / void sale (salesSttsCd 04)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/sales/{{organizationId}}/{{saleId}}/cancel
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "reason": "Postman void"
  }
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
