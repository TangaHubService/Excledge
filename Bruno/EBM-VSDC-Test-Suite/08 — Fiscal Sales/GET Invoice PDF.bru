meta {
  name: GET Invoice PDF
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/sales/{{organizationId}}/invoices/{{saleId}}/pdf
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
