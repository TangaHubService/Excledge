meta {
  name: POST Create sale (fiscalizes via outbox)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sales/{{organizationId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "branchId": "{{branchId}}",
    "paymentMethod": "CASH",
    "items": [
      {
        "productId": "{{productId}}",
        "quantity": 1,
        "unitPrice": 1180
      }
    ]
  }
}

script:post-response {
  test('created-ish', () => expect(res.getStatus()).to.be.below(500));
  const j = res.getBody();
  const id = j?.data?.id || j?.sale?.id || j?.id;
  if (id) bru.setEnvVar('saleId', String(id));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
