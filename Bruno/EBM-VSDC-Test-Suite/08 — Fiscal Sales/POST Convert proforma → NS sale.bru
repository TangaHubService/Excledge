meta {
  name: POST Convert proforma → NS sale
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/sales/{{organizationId}}/{{saleId}}/convert
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
