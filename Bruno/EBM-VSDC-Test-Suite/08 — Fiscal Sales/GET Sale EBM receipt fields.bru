meta {
  name: GET Sale EBM receipt fields
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/sales/{{organizationId}}/{{saleId}}/ebm-receipt
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

script:post-response {
  test('2xx/expected', () => expect(res.getStatus()).to.be.below(600));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
